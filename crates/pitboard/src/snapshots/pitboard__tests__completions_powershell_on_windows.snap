            break
        }
        'pitboard;help;watch;status' {
            break
        }
        'pitboard;help;watch;uninstall' {
            break
        }
        'pitboard;help;warm' {
            [CompletionResult]::new('now', 'now', [CompletionResultType]::ParameterValue, 'Start an account''s five-hour period now, whatever the span, through one short request Claude Code makes with that account''s login')
            [CompletionResult]::new('on', 'on', [CompletionResultType]::ParameterValue, 'Warm up an account from now on, within the span `range` sets')
            [CompletionResult]::new('off', 'off', [CompletionResultType]::ParameterValue, 'Stop warming up an account')
            [CompletionResult]::new('range', 'range', [CompletionResultType]::ParameterValue, 'Warm up accounts only between these times of each day, in this computer''s time zone')
            break
        }
        'pitboard;help;warm;now' {
            break
        }
        'pitboard;help;warm;on' {
            break
        }
        'pitboard;help;warm;off' {
            break
        }
        'pitboard;help;warm;range' {
            break
        }
        'pitboard;help;statusline' {
            break
        }
        'pitboard;help;renew' {
            break
        }
        'pitboard;help;schedule' {
            [CompletionResult]::new('install', 'install', [CompletionResultType]::ParameterValue, 'Ask this computer''s own scheduler to renew parked logins daily')
            [CompletionResult]::new('status', 'status', [CompletionResultType]::ParameterValue, 'Say whether it is installed')
            [CompletionResult]::new('uninstall', 'uninstall', [CompletionResultType]::ParameterValue, 'Take it away')
            break
        }
        'pitboard;help;schedule;install' {
            break
        }
        'pitboard;help;schedule;status' {
            break
        }
        'pitboard;help;schedule;uninstall' {
            break
        }
        'pitboard;help;vault' {
            [CompletionResult]::new('status', 'status', [CompletionResultType]::ParameterValue, 'Say where parked logins are kept (the default)')
            [CompletionResult]::new('move', 'move', [CompletionResultType]::ParameterValue, 'Move every parked login to another way of keeping them, which Windows does not offer')
            break
        }
        'pitboard;help;vault;status' {
            break
        }
        'pitboard;help;vault;move' {
            break
        }
        'pitboard;help;log' {
            break
        }
        'pitboard;help;doctor' {
            break
        }
        'pitboard;help;uninstall' {
            break
        }
        'pitboard;help;stow' {
            break
        }
        'pitboard;help;repair' {
            break
        }
        'pitboard;help;abandon' {
            break
        }
        'pitboard;help;adopt' {
            break
        }
        'pitboard;help;completions' {
            break
        }
        'pitboard;help;help' {
            break
        }
    })

    $completions.Where{ $_.CompletionText -like "$wordToComplete*" } |
        Sort-Object -Property ListItemText
}
