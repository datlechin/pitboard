---
source: crates/pitboard/src/main.rs
expression: "completions(clap_complete::Shell::PowerShell)"
---

using namespace System.Management.Automation
using namespace System.Management.Automation.Language

Register-ArgumentCompleter -Native -CommandName 'pitboard' -ScriptBlock {
    param($wordToComplete, $commandAst, $cursorPosition)

    $commandElements = $commandAst.CommandElements
    $command = @(
        'pitboard'
        for ($i = 1; $i -lt $commandElements.Count; $i++) {
            $element = $commandElements[$i]
            if ($element -isnot [StringConstantExpressionAst] -or
                $element.StringConstantType -ne [StringConstantType]::BareWord -or
                $element.Value.StartsWith('-') -or
                $element.Value -eq $wordToComplete) {
                break
        }
        $element.Value
    }) -join ';'

    $completions = @(switch ($command) {
        'pitboard' {
            [CompletionResult]::new('--json', '--json', [CompletionResultType]::ParameterName, 'Print JSON instead of text')
            [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Print help')
            [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help')
            [CompletionResult]::new('-V', '-V ', [CompletionResultType]::ParameterName, 'Print version')
            [CompletionResult]::new('--version', '--version', [CompletionResultType]::ParameterName, 'Print version')
            [CompletionResult]::new('status', 'status', [CompletionResultType]::ParameterValue, 'What is signed in, and how much each Claude Code and Codex account has left (the default)')
            [CompletionResult]::new('use', 'use', [CompletionResultType]::ParameterValue, 'Switch a tool to an enrolled account')
            [CompletionResult]::new('enroll', 'enroll', [CompletionResultType]::ParameterValue, 'Add an account: the one signed in now, or with --sign-in, another one')
            [CompletionResult]::new('rename', 'rename', [CompletionResultType]::ParameterValue, 'Change the label an account is enrolled under')
            [CompletionResult]::new('forget', 'forget', [CompletionResultType]::ParameterValue, 'Drop an account and its parked login')
            [CompletionResult]::new('watch', 'watch', [CompletionResultType]::ParameterValue, 'Switch Claude Code before the account in use runs out, and warm up accounts')
            [CompletionResult]::new('warm', 'warm', [CompletionResultType]::ParameterValue, 'Start an account''s five-hour period early, so it resets sooner')
            [CompletionResult]::new('statusline', 'statusline', [CompletionResultType]::ParameterValue, 'One line for Claude Code''s status bar; reads its session JSON on stdin')
            [CompletionResult]::new('renew', 'renew', [CompletionResultType]::ParameterValue, 'Renew every parked login that is due, and nothing else')
            [CompletionResult]::new('schedule', 'schedule', [CompletionResultType]::ParameterValue, 'Keep parked logins alive without running anything yourself')
            [CompletionResult]::new('vault', 'vault', [CompletionResultType]::ParameterValue, 'Where parked logins are kept: in files sealed to your Windows account')
            [CompletionResult]::new('log', 'log', [CompletionResultType]::ParameterValue, 'What Pitboard has changed, and when')
            [CompletionResult]::new('doctor', 'doctor', [CompletionResultType]::ParameterValue, 'Check that what Pitboard relies on still holds on this machine')
            [CompletionResult]::new('uninstall', 'uninstall', [CompletionResultType]::ParameterValue, 'Delete every parked login this Pitboard wrote, the daily renewal schedule, the watch service and Pitboard''s own files')
            [CompletionResult]::new('stow', 'stow', [CompletionResultType]::ParameterValue, 'Put away the login Claude Code left in a file behind Credential Manager, then delete the file')
            [CompletionResult]::new('repair', 'repair', [CompletionResultType]::ParameterValue, 'Ask the credential store what parked logins are here, and account for every one')
            [CompletionResult]::new('abandon', 'abandon', [CompletionResultType]::ParameterValue, 'Give up on an interrupted switch that cannot be finished, keeping every login')
            [CompletionResult]::new('adopt', 'adopt', [CompletionResultType]::ParameterValue, 'Take over a Pitboard directory another computer wrote, keeping the accounts')
            [CompletionResult]::new('completions', 'completions', [CompletionResultType]::ParameterValue, 'Print a shell completion script')
            [CompletionResult]::new('help', 'help', [CompletionResultType]::ParameterValue, 'Print this message or the help of the given subcommand(s)')
            break
        }
        'pitboard;status' {
            [CompletionResult]::new('--offline', '--offline', [CompletionResultType]::ParameterName, 'Answer from what was last measured, without asking anyone')
            [CompletionResult]::new('--fresh', '--fresh', [CompletionResultType]::ParameterName, 'Ask about every account, even one asked about moments ago')
            [CompletionResult]::new('--json', '--json', [CompletionResultType]::ParameterName, 'Print JSON instead of text')
            [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Print help')
            [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help')
            break
        }
        'pitboard;use' {
            [CompletionResult]::new('-y', '-y', [CompletionResultType]::ParameterName, 'Where the service refuses the login in use for good, put this account''s login in its place without asking; needed without a terminal or with `--json`')
            [CompletionResult]::new('--yes', '--yes', [CompletionResultType]::ParameterName, 'Where the service refuses the login in use for good, put this account''s login in its place without asking; needed without a terminal or with `--json`')
            [CompletionResult]::new('--json', '--json', [CompletionResultType]::ParameterName, 'Print JSON instead of text')
