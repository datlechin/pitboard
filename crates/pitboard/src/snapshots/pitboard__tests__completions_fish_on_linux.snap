complete -c pitboard -n "__fish_pitboard_using_subcommand help; and __fish_seen_subcommand_from warm" -f -a "range" -d 'Warm up accounts only between these times of each day, in this computer\'s time zone'
complete -c pitboard -n "__fish_pitboard_using_subcommand help; and __fish_seen_subcommand_from schedule" -f -a "install" -d 'Ask this computer\'s own scheduler to renew parked logins daily'
complete -c pitboard -n "__fish_pitboard_using_subcommand help; and __fish_seen_subcommand_from schedule" -f -a "status" -d 'Say whether it is installed'
complete -c pitboard -n "__fish_pitboard_using_subcommand help; and __fish_seen_subcommand_from schedule" -f -a "uninstall" -d 'Take it away'
complete -c pitboard -n "__fish_pitboard_using_subcommand help; and __fish_seen_subcommand_from vault" -f -a "status" -d 'Say where parked logins are kept (the default)'
