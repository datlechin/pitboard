---
source: crates/pitboard/src/main.rs
expression: "completions(clap_complete::Shell::Zsh)"
---
#compdef pitboard

autoload -U is-at-least

_pitboard() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--json[Print JSON instead of text]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_pitboard_commands" \
"*::: :->pitboard" \
&& ret=0
    case $state in
    (pitboard)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:pitboard-command-$line[1]:"
        case $line[1] in
            (status)
_arguments "${_arguments_options[@]}" : \
'--offline[Answer from what was last measured, without asking anyone]' \
'(--offline)--fresh[Ask about every account, even one asked about moments ago]' \
'--json[Print JSON instead of text]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(use)
_arguments "${_arguments_options[@]}" : \
'-y[Where the service refuses the login in use for good, put this account'\''s login in its place without asking; needed without a terminal or with \`--json\`]' \
'--yes[Where the service refuses the login in use for good, put this account'\''s login in its place without asking; needed without a terminal or with \`--json\`]' \
'--json[Print JSON instead of text]' \
'-h[Print help]' \
'--help[Print help]' \
':label -- The label the account was enrolled under, such as `work` or `codex/work`:_default' \
&& ret=0
;;
(enroll)
_arguments "${_arguments_options[@]}" : \
'--sign-in[Sign in to another account first, through the tool'\''s own sign-in]' \
'--json[Print JSON instead of text]' \
'-h[Print help]' \
'--help[Print help]' \
':label -- A short name for this account, such as `personal` or `work`. `codex/work` names a Codex account; a bare name means Claude Code:_default' \
&& ret=0
;;
(rename)
_arguments "${_arguments_options[@]}" : \
'--json[Print JSON instead of text]' \
'-h[Print help]' \
'--help[Print help]' \
':from -- The label it has now:_default' \
':to -- The label it should have:_default' \
&& ret=0
;;
(forget)
_arguments "${_arguments_options[@]}" : \
'-y[Do not ask first; needed without a terminal or with \`--json\`]' \
'--yes[Do not ask first; needed without a terminal or with \`--json\`]' \
'--json[Print JSON instead of text]' \
'-h[Print help]' \
'--help[Print help]' \
':label -- The label to drop:_default' \
&& ret=0
;;
(watch)
_arguments "${_arguments_options[@]}" : \
'--at=[Switch once a limit of the account in use reaches this share, from 50 to 99]:PERCENT:_default' \
'--once[Decide once whether to switch, from the usage Pitboard last measured, asking no service for usage, and stop. Warms nothing up]' \
'--json[Print JSON instead of text]' \
'-h[Print help]' \
'--help[Print help]' \
":: :_pitboard__subcmd__watch_commands" \
"*::: :->watch" \
&& ret=0

    case $state in
    (watch)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:pitboard-watch-command-$line[1]:"
        case $line[1] in
            (install)
_arguments "${_arguments_options[@]}" : \
'--at=[Switch once a limit of the account in use reaches this share, from 50 to 99]:PERCENT:_default' \
'--json[Print JSON instead of text]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
'--json[Print JSON instead of text]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(uninstall)
_arguments "${_arguments_options[@]}" : \
'--json[Print JSON instead of text]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_pitboard__subcmd__watch__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:pitboard-watch-help-command-$line[1]:"
        case $line[1] in
            (install)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(uninstall)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
;;
(warm)
_arguments "${_arguments_options[@]}" : \
'--json[Print JSON instead of text]' \
'-h[Print help]' \
'--help[Print help]' \
":: :_pitboard__subcmd__warm_commands" \
"*::: :->warm" \
&& ret=0

    case $state in
    (warm)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:pitboard-warm-command-$line[1]:"
        case $line[1] in
            (now)
_arguments "${_arguments_options[@]}" : \
'--json[Print JSON instead of text]' \
'-h[Print help]' \
'--help[Print help]' \
':label -- The label the account was enrolled under, such as `work`:_default' \
&& ret=0
;;
(on)
_arguments "${_arguments_options[@]}" : \
'--json[Print JSON instead of text]' \
'-h[Print help]' \
'--help[Print help]' \
':label -- The label the account was enrolled under, such as `work`:_default' \
&& ret=0
;;
(off)
_arguments "${_arguments_options[@]}" : \
'--json[Print JSON instead of text]' \
'-h[Print help]' \
'--help[Print help]' \
':label -- The label the account was enrolled under:_default' \
&& ret=0
;;
(range)
_arguments "${_arguments_options[@]}" : \
'--json[Print JSON instead of text]' \
'-h[Print help]' \
'--help[Print help]' \
':from -- When to start, such as 06\:00:_default' \
':to -- When to stop, such as 22\:00; 00\:00 and 24\:00 are midnight, and a time before FROM runs past it:_default' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_pitboard__subcmd__warm__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:pitboard-warm-help-command-$line[1]:"
        case $line[1] in
            (now)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(on)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(off)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(range)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
;;
(statusline)
_arguments "${_arguments_options[@]}" : \
'--json[Print JSON instead of text]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(renew)
_arguments "${_arguments_options[@]}" : \
