        &'pitboard;vault'= {
            cand --json 'Print JSON instead of text'
            cand -h 'Print help'
            cand --help 'Print help'
            cand status 'Say where parked logins are kept (the default)'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'pitboard;vault;status'= {
            cand --json 'Print JSON instead of text'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'pitboard;vault;help'= {
            cand status 'Say where parked logins are kept (the default)'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'pitboard;vault;help;status'= {
        }
        &'pitboard;vault;help;help'= {
        }
        &'pitboard;log'= {
            cand -n 'How many changes to show'
            cand --lines 'How many changes to show'
            cand --json 'Print JSON instead of text'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'pitboard;doctor'= {
            cand --json 'Print JSON instead of text'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'pitboard;uninstall'= {
            cand -y 'Do not ask first; needed without a terminal or with `--json`'
            cand --yes 'Do not ask first; needed without a terminal or with `--json`'
            cand --json 'Print JSON instead of text'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'pitboard;stow'= {
            cand -y 'Do not ask first; needed without a terminal or with `--json`'
            cand --yes 'Do not ask first; needed without a terminal or with `--json`'
            cand --json 'Print JSON instead of text'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'pitboard;repair'= {
