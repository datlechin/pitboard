            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'pitboard;schedule;uninstall'= {
            cand --json 'Print JSON instead of text'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'pitboard;schedule;help'= {
            cand install 'Ask this computer''s own scheduler to renew parked logins daily'
            cand status 'Say whether it is installed'
            cand uninstall 'Take it away'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'pitboard;schedule;help;install'= {
        }
        &'pitboard;schedule;help;status'= {
        }
        &'pitboard;schedule;help;uninstall'= {
        }
        &'pitboard;schedule;help;help'= {
