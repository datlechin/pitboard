---
// An app figure, drawn for macOS by its default slot and for each other system by the slot named
// after it, `linux` for both desktops at once; with a `cli` slot, its terminal twin. It draws each
// system `on` names, its section's, and lib/platform.ts refuses one it lacks. Captions and
// descriptions are HTML; a drawing that works speaks for itself, and src/scripts/live/figure.ts
// hides its description.
import Choice from "./Choice.astro";
import {
  drawingsOf,
  onOf,
  systems,
  wordsOf,
  type Desktop,
  type Platform,
  type System,
} from "../../lib/platform.ts";

interface Side {
  caption: string;
  describe: string;
}
type Sides = Partial<Record<Platform | Desktop, Side>>;
interface Props {
  app: Sides;
  cli?: Sides;
  on?: System[];
  class?: string;
}
const { app, cli, on = systems, class: extra } = Astro.props;
const both = cli !== undefined && Astro.slots.has("cli");
const slots: [Platform | Desktop, string][] = [
  ["macos", "default"],
  ["windows", "windows"],
  ["linux", "linux"],
  ["gnome", "gnome"],
  ["kde", "kde"],
];
const given = slots.filter(([, slot]) => Astro.slots.has(slot)).map(([drawn]) => drawn);
const drawings = drawingsOf(given, on);
// each drawing's data-on, by its slot
const drawnOn = Object.fromEntries(given.map((d, i) => [d, onOf(drawings[i])])) as Partial<
  Record<Platform | Desktop, string>
>;
const onApp = both ? "block surface-cli:hidden" : "block";
const onCli = "block surface-app:hidden no-js:mt-6";
// each surface's words, with the systems they describe
const captions: [string, "app" | "cli", [System[], Side][]][] = [
  [onApp, "app", wordsOf(app, drawings.flat())],
];
if (both) captions.push([onCli, "cli", wordsOf(cli!)]);
---

<figure class:list={["min-w-0", extra]}>
  {both && (
    <Choice
      class="mb-3"
      name="surface"
      label="Show Pitboard as"
      options={[
        ["app", "App"],
        ["cli", "Command line"],
      ]}
    />
  )}
  <div class="@container">
    <div class={onApp}>
      {drawnOn.macos && <div data-drawing="app macos" data-on={drawnOn.macos}><slot /></div>}
      {drawnOn.windows && <div data-drawing="app windows" data-on={drawnOn.windows}>
        <slot name="windows" />
      </div>}
      {drawnOn.linux && <div data-drawing="app linux" data-on={drawnOn.linux}>
        <slot name="linux" />
      </div>}
      {drawnOn.gnome && <div data-drawing="app gnome" data-on={drawnOn.gnome}>
        <slot name="gnome" />
      </div>}
      {drawnOn.kde && <div data-drawing="app kde" data-on={drawnOn.kde}>
        <slot name="kde" />
      </div>}
    </div>
    {both && <div class={onCli}>
      <slot name="cli" />
    </div>}
  </div>
  <figcaption class="mt-3.5 font-mono text-ui text-muted [&_code]:text-[1em] [&_code]:text-muted">
    {captions.map(([shown, surface, said]) => <span class={shown}>
      {said.map(([described, s]) => <span data-on={onOf(described)}
        ><span class="sr-only" data-describes={surface} set:html={`${s.describe} `} /><span
          set:html={s.caption}
      /></span>)}
    </span>)}
    {/* a live figure shows it once something on the page has changed */}
    <button
      class="ml-2 cursor-pointer rounded-sm border border-edge px-2.5 py-0.75 font-mono text-label font-medium text-fg hover:bg-ink/7"
      type="button"
      data-reset
      hidden
    >
      Reset
    </button>
  </figcaption>
</figure>
