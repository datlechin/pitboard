---
// Konsole 26.08.2 under KWin's Breeze decoration, in the colours Fedora's Plasma gives an app. The
// title bar is the 20 pixel buttons with 4 above and below (breezedecoration.cpp, its grid unit
// Noto Sans 10's "M"), the window's icon at its start and, with one virtual desktop, no On All
// Desktops button, the title centred over the whole width, then Minimize, Maximize and Close as
// breezebutton.cpp draws them. Breeze's tools area holds the menu bar and the toolbars in
// Fedora's 9 point toolbar font (breezemetrics.h), then the terminal in Konsole's Breeze scheme
// and Noto Sans Mono 10 with its 1 pixel margin, 80 columns where its profile opens 110, the
// scrollbar's 21 pixels kept empty (approx). Output colours spans g, y, r, dim (SGR 2's faint)
// and b (bold's intense).
import Icon from "./Icon.astro";
import { konsoleMenus, konsoleTools } from "../../../data/kde.ts";

interface Props {
  title: string;
  // the window's own, which its ids start with
  id: string;
  // a shell's window keeps its output as a log its title names; live, it grows with its output to
  // Konsole's 28 rows, then scrolls
  solo?: boolean;
  class?: string;
}
const { title, id, solo = false, class: extra } = Astro.props;
// breezebutton.cpp's marks, drawn in an 18 unit box a unit in from the button's 20
const mark = "size-20 shrink-0 fill-none stroke-current";
---

<div
  class:list={[
    "z-1 flex flex-col overflow-hidden rounded-u-5 bg-kde-term-bg font-kde text-kde text-kde-header-text shadow-kde-window outline-1 outline-kde-header-edge",
    solo ? "relative w-663" : "absolute",
    extra,
  ]}
>
  <div class="relative flex h-28 flex-none items-center bg-kde-header px-4">
    <Icon name="apps/22/utilities-terminal" key={`${id}-icon`} class="size-20" />
    <span
      class="pointer-events-none absolute inset-x-0 truncate px-76 text-center"
      id={`${id}-title`}
      >{title}</span
    >
    <span class="ml-auto flex gap-4" aria-hidden="true">
      <svg class={mark} viewBox="-1 -1 20 20" stroke-width="1" stroke-linecap="round">
        <path d="m4 7 5 5 5-5"></path>
      </svg>
      <svg class={mark} viewBox="-1 -1 20 20" stroke-width="1" stroke-linecap="round">
        <path d="m4 11 5-5 5 5"></path>
      </svg>
      <svg class={mark} viewBox="-1 -1 20 20" stroke-width="1" stroke-linecap="round">
        <path d="m5 5 8 8m0-8-8 8"></path>
      </svg>
    </span>
  </div>
  <div class="flex-none bg-kde-header" aria-hidden="true">
    <div class="flex h-31 items-center">
      {konsoleMenus.map((menu) => <span class="px-10">{menu}</span>)}
    </div>
    <div class="flex h-46 items-center p-6 text-kde-tool">
      {konsoleTools.map((group, i) => <span class:list={["flex", { "ml-auto": i > 0 }]}>
        {group.map((t) => <span class="flex h-34 items-center gap-4 px-6">
          <Icon name={t.icon} key={`${id}-${t.icon.split("/").pop()}`} />
          {t.text}
          {t.menu && <svg class="size-12 shrink-0 fill-none stroke-current" viewBox="0 0 12 12">
            <path d="m3 4.5 3 3 3-3" stroke-width="1"></path>
          </svg>}
        </span>)}
      </span>)}
    </div>
    <div class="h-1 bg-kde-header-edge"></div>
  </div>
  <div
    class:list={[
      "flex min-h-0 flex-1 flex-col overflow-hidden py-1 pr-22 pl-1 font-kde-mono text-kde/18 whitespace-pre text-kde-term-text ligatures-none *:min-h-18 [&_.dim]:text-kde-term-faint [&_.g]:text-kde-term-green [&_.r]:text-kde-term-red [&_.y]:text-kde-term-yellow [&_b]:font-bold [&_b]:text-kde-term-intense",
      solo
        ? "justify-start *:whitespace-pre-wrap live:max-h-[calc(28lh+var(--spacing)*2)] live:min-h-(--min) live:overflow-y-auto live:select-text"
        : "justify-end",
    ]}
    role={solo ? "log" : undefined}
    aria-labelledby={solo ? `${id}-title` : undefined}
  >
    <slot />
  </div>
</div>
