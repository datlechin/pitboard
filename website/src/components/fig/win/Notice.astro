---
// WindowsNotifications.cs's run-out toast; its metrics are approx until read on Windows.
import Button from "./Button.astro";
import Taskbar from "./Taskbar.astro";
import TrayItem from "./TrayItem.astro";
import { toast } from "../../../data/windows.ts";
import { windowsClock } from "../../../data/world.ts";
---

<div class="desk h-260 desk-px-720" aria-hidden="true" data-output>
  <div
    class="absolute right-12 bottom-60 z-3 flex w-364 flex-col rounded-u-8 bg-win-flyout p-16 font-win text-u-14/20 text-win-text-2 shadow-win-flyout"
  >
    <span class="flex items-center gap-8 text-u-12/16">
      <svg class="size-16 shrink-0"><use href="#pb-tray"></use></svg>
      <span class="flex-1">{toast.app}</span>
      <svg class="size-16"><use href="#fl-more"></use></svg>
      <svg class="ml-8 size-16"><use href="#fl-dismiss"></use></svg>
    </span>
    <b class="mt-12 font-semibold text-win-text">{toast.title}</b>
    <span>{toast.tool}</span>
    <span>{toast.body}</span>
    <span class="mt-16 text-win-text"><Button stretch>{toast.button}</Button></span>
  </div>
  <Taskbar time={windowsClock.runOut.time} date={windowsClock.runOut.date}>
    <TrayItem level="r" />
  </Taskbar>
</div>
