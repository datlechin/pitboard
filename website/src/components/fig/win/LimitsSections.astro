---
// SettingsPage.xaml's Limits: When a limit reaches, open on its share, dimmed while nothing
// happens at it, and Warm-up, open on its hours and accounts, what it does under its name
// and its hours beside it, each a section live/limits.ts works, each with its icon. Each control is
// named as the XAML names it; each expander's button shows and hides its items, and their ids start
// `prefix`. Every choice's words are drawn, those of the choice not shown hidden. Is this allowed?
// is the link alone, under When a limit reaches whatever is chosen. The time pickers' flyouts
// open over the window, from the desk, where `flyouts` draws them alone.
import ComboBox from "./ComboBox.astro";
import NumberBox from "./NumberBox.astro";
import TimePicker from "./TimePicker.astro";
import Toggle from "./Toggle.astro";
import { settingsPage as page } from "../../../data/windows.ts";
import { choices, heading } from "../../../data/limits.ts";
import { DOCS } from "../../../data/site.ts";
import { moments, share, warmUp } from "../../../data/world.ts";
import type { AtLimit } from "../../../lib/model.ts";
import { atLimitNote } from "../../../lib/words.ts";
import { toolAccounts } from "../../../lib/words.ts";

const minutes = (at: string) => {
  const [h, m] = at.split(":").map(Number);
  return h * 60 + m;
};

interface Props {
  prefix: string;
  show: "switch" | "warm" | "both";
  // the time pickers' flyouts, which the desk holds
  flyouts?: boolean;
}
const { prefix, show, flyouts = false } = Astro.props;
const items = `${prefix}-items`;
const warmItems = `${prefix}-warm-items`;
const atLimit = show !== "warm";
const warming = show !== "switch";
const caption = "text-u-12/16 text-win-text-2";
const header =
  "flex min-h-68 items-center gap-16 rounded-t-u-4 bg-win-card p-16 inset-shadow-win-layer-edge";
// DefaultSettingsExpanderItemStyle's card, the last one rounded at the foot
const item = "flex items-center gap-16 bg-win-card-2 py-8 pr-44 pl-58 inset-shadow-win-layer-edge";
// the expander's toggle, its chevron turning as it closes
const toggle =
  "group/toggle flex size-32 shrink-0 items-center justify-center rounded-u-4 focus-win live:hover:bg-win-subtle";
const chevron = "size-12 transition-transform group-aria-[expanded=false]/toggle:rotate-180";
const drawn: AtLimit = "switch";
// the hours, and each Claude Code account with its id, which a working figure follows
const hours = [
  ["From", "from", minutes(warmUp.from)],
  ["To", "to", minutes(warmUp.to)],
] as const;
const warmAccounts = toolAccounts(moments.after, "claude").map((a, i) => ({
  id: a.id,
  ...page.warm.accounts[i],
}));
const card = "min-h-48 last:rounded-b-u-4";
const link =
  "text-win-accent-text focus-win live:text-win-accent-text live:hover:text-win-accent-text";
const icon = "size-20 shrink-0";
---

{flyouts ? (
  hours.map(([, end, minutes]) => (
    <TimePicker prefix={`${prefix}-${end}`} minutes={minutes} label={`Warm up ${end}`} flyout />
  ))
) : (
  <>
    {atLimit && <div class="group/section" data-section="at-limit">
      <div
        class:list={[
          header,
          "has-[[data-expander][aria-expanded=false]]:rounded-b-u-4 live:hover:bg-win-control-2",
        ]}
        data-header
      >
        <svg class={icon} aria-hidden="true"><use href="#fl-top-speed"></use></svg>
        <span class="min-w-0 flex-1">
          <span class="block">{page.atLimit.header}</span>
          <span class:list={["block", caption]} data-standing>{page.atLimit.standing}</span>
          {choices.map((c) =>
            c.value === "nothing" ? null : (
              <span class:list={["block", caption]} data-note={c.value} hidden={c.value !== drawn}>
                {atLimitNote({ atLimit: c.value, chosen: true, share })}
              </span>
            ),
          )}
          <a
            class:list={["block w-fit no-underline", caption, link]}
            href={`${DOCS}/concepts/limits#is-this-allowed`}
            target="_blank"
            rel="noopener"
            >{page.atLimit.link}</a
          >
        </span>
        <ComboBox
          prefix={prefix}
          options={choices.map((c) => ({ value: c.value, title: c.win }))}
          value={drawn}
          label={page.atLimit.label}
          listLabel={heading}
        />
        <button
          class={toggle}
          id={`${prefix}-expand`}
          type="button"
          data-expander
          aria-label={page.atLimit.header}
          aria-expanded="true"
          aria-controls={items}
        >
          <svg class={chevron}><use href="#fl-chevron-up"></use></svg>
        </button>
      </div>
      <div id={items}>
        {/* a SettingsCard's header and description dim with it */}
        <div
          class:list={[item, "group/share rounded-b-u-4 has-[:disabled]:text-win-text-off"]}
          data-share-card
        >
          <span class="min-w-0 flex-1">
            <span class="block">{page.share.header}</span>
            <span class:list={["block", caption, "group-has-[:disabled]/share:text-win-text-off"]}
              >{page.share.range}</span
            >
          </span>
          <NumberBox prefix={prefix} value={page.share.value} label={page.share.header} />
        </div>
      </div>
    </div>}
    {warming && <div data-section="warm">
      <div
        class:list={[
          header,
          "has-[[data-expander][aria-expanded=false]]:rounded-b-u-4 live:hover:bg-win-control-2",
        ]}
        data-header
      >
        <svg class={icon} aria-hidden="true"><use href="#fl-weather-sunny"></use></svg>
        <span class="min-w-0 flex-1">
          <span class="block">{page.warm.header}</span>
          <span class:list={["block", caption]}>{page.warm.note}</span>
          <span class:list={["block", caption]} data-next>{page.warm.standing}</span>
        </span>
        <span class="shrink-0 whitespace-nowrap tabular-nums" data-range>{page.warm.range}</span>
        <button
          class={toggle}
          id={`${prefix}-warm-expand`}
          type="button"
          data-expander
          aria-label={page.warm.header}
          aria-expanded="true"
          aria-controls={warmItems}
        >
          <svg class={chevron}><use href="#fl-chevron-up"></use></svg>
        </button>
      </div>
      <div id={warmItems}>
        {hours.map(([name, end, minutes]) => <div class:list={[item, "min-h-48"]}>
          <span class="min-w-0 flex-1">{name}</span>
          <TimePicker prefix={`${prefix}-${end}`} minutes={minutes} label={`Warm up ${end}`} />
        </div>)}
        <div data-accounts>
          {warmAccounts.map((a) => <div class:list={[item, card]} data-account={a.id}>
            <span class="min-w-0 flex-1">
              <span class="block" data-title>{a.title}</span>
              <span class:list={["block", caption]} data-note hidden={!a.standing}
                >{a.standing}</span
              >
            </span>
            <Toggle on={a.on} aria-label={a.title} />
          </div>)}
        </div>
        {/* a card for an account added on the page */}
        <template data-row>
          <div class:list={[item, card]} data-account="">
            <span class="min-w-0 flex-1">
              <span class="block" data-title></span>
              <span class:list={["block", caption]} data-note hidden></span>
            </span>
            <Toggle />
          </div>
        </template>
      </div>
    </div>}
  </>
)}
