---
// IconMenu.cs's menu over Windows Terminal; where it opens is approx until read on Windows. The
// icon is a button the Shell names by its tooltip, and its menu's ids each start `prefix`.
import IconMenu from "./IconMenu.astro";
import Taskbar from "./Taskbar.astro";
import Terminal from "./Terminal.astro";
import Tooltip from "./Tooltip.astro";
import TrayItem from "./TrayItem.astro";
import { session } from "../../../data/desk.ts";
import { accountTip } from "../../../data/windows.ts";
import { clock, moments } from "../../../data/world.ts";
import { hm, menuBarLevel, shortDate, statusLine, trayTip } from "../../../lib/words.ts";

interface Props {
  prefix: string;
  demo?: boolean;
  submenu?: string;
  updates?: boolean;
}
const { prefix, demo = false, submenu, updates = false } = Astro.props;
const icon = `${prefix}-icon`;
// The session's status line follows the switch after the menu does.
const [before, after] = [statusLine(moments.before), statusLine(moments.after)];
const status =
  demo && before !== after
    ? `<span class="hidden demo:inline">${before}</span><span class="demo:hidden">${after}</span>`
    : after;
const rule =
  "bg-linear-to-b from-win-term-dim to-win-term-dim bg-size-[100%_1px] bg-position-[0_50%] bg-no-repeat";
// WinUI centres a tooltip above the pointer, and Check for updates' row puts each row 32 higher.
const pointer = submenu
  ? updates
    ? "translate-x-160 -translate-y-225"
    : "translate-x-160 -translate-y-193"
  : updates
    ? "demo-start:-translate-x-180 demo-start:-translate-y-240 demo-row:translate-x-60 demo-row:-translate-y-413"
    : "demo-start:-translate-x-180 demo-start:-translate-y-240 demo-row:translate-x-60 demo-row:-translate-y-381";
const rowTip = updates ? "bottom-450" : "bottom-418";
---

<pb-tray
  id={prefix}
  class:list={["desk block desk-px-720", updates ? "h-572" : "h-540"]}
  data-demo-desk={demo ? "" : undefined}
  inert
  data-output
>
  <Terminal
    class="top-14 bottom-62 left-14 w-600 [&_.elbow]:mr-3 [&_.elbow]:ml-1 [&_.elbow]:size-9 [&_.elbow]:align-[calc(var(--spacing)*4)]"
  >
    <Fragment slot="title">
      <svg class="size-10 shrink-0 fill-none stroke-current" viewBox="0 0 10 10" stroke-width="1.3">
        <path d="M5 0v10M0 5h10M1.5 1.5l7 7m0-7-7 7"></path>
      </svg>
      Claude Code
    </Fragment>
    {session.map((line) => (
      <div set:html={line} />
    ))}
    <div class={rule}></div>
    <div>&gt; <span class="bg-win-term-text"> </span></div>
    <div class={rule}></div>
    <div set:html={`  ${status}`} />
  </Terminal>
  <Taskbar time={hm(clock.menuBar)} date={shortDate(clock.menuBar)}>
    <TrayItem
      on
      id={icon}
      name={trayTip(moments.after)}
      level={menuBarLevel(moments.after)}
      was={demo ? menuBarLevel(moments.before) : undefined}
      class={demo ? "demo-shut:bg-transparent demo-reach:bg-win-subtle" : undefined}
    />
  </Taskbar>
  <IconMenu
    class="absolute right-6 bottom-48 z-3"
    prefix={prefix}
    owner={icon}
    demo={demo}
    updates={updates}
    submenu={submenu}
  />
  {demo && <Tooltip
    id={`${prefix}-tip`}
    class:list={["absolute left-560 z-3 hidden -translate-x-1/2 demo-hl:block", rowTip]}
    >{accountTip("work", moments.before)}</Tooltip
  >}
  {/* the Shell's tooltip, which names the icon */}
  {demo && <Tooltip
    class="absolute bottom-56 left-500 z-3 hidden -translate-x-1/2 demo-reach:block"
    aria-hidden="true"
    >{trayTip(moments.after)
      .split("\n")
      .map((line) => <span class="block">{line}</span>)}</Tooltip
  >}
  <svg
    aria-hidden="true"
    class:list={[
      "pointer-events-none absolute bottom-8 left-500 z-4 h-21 w-13 origin-[1px_1px] transition-transform duration-800 ease-out",
      { "demo-pick:scale-86 demo-pick:duration-100": demo },
      pointer,
    ]}
    viewBox="0 0 13 21"
  >
    <path
      class="fill-white stroke-black"
      d="M.5.5v17.6l4.3-4.2 2.9 6.7 2.6-1.1-2.9-6.6h6Z"
      stroke-width="1"
      stroke-linejoin="round"
    ></path>
  </svg>
</pb-tray>
