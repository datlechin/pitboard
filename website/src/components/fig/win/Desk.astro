---
// IconMenu.cs's menu over Windows Terminal, opened where the pointer right-clicked the icon: its
// right edge at the point and its bottom on the taskbar's top, as the app's UI tests read it on
// windows-2025 (docs/facts/site.md). The icon is a button the Shell names by its tooltip, and its
// menu's ids each start `prefix`. The
// hero's desk is live/tray.ts's, and the moment after its switch follows the one state; with
// `submenu`, the desk shows a site's submenu open, a drawing of its own.
import IconMenu from "./IconMenu.astro";
import Taskbar from "./Taskbar.astro";
import Terminal from "./Terminal.astro";
import Tooltip from "./Tooltip.astro";
import TrayItem from "./TrayItem.astro";
import { session } from "../../../data/desk.ts";
import { accountTip } from "../../../data/windows.ts";
import { clock, moments } from "../../../data/world.ts";
import {
  hm,
  menuBarLevel,
  menuLine,
  shellTip,
  shortDate,
  statusLine,
  toolsOn,
  trayTip,
} from "../../../lib/words.ts";

interface Props {
  prefix: string;
  demo?: boolean;
  submenu?: string;
  updates?: boolean;
}
const { prefix, demo = false, submenu, updates = false } = Astro.props;
const live = submenu === undefined;
const Root = live ? "pb-tray" : "pb-open-link";
const icon = `${prefix}-icon`;
const after = moments.after;
// The session's status line follows the switch after the menu does.
const [before, now] = [statusLine(moments.before), statusLine(after)];
const status =
  demo && before !== now
    ? `<span class="hidden demo:inline">${before}</span><span class="demo:hidden" data-part="status">${now}</span>`
    : `<span data-part="status">${now}</span>`;
const rule =
  "bg-linear-to-b from-win-term-dim to-win-term-dim bg-size-[100%_1px] bg-position-[0_50%] bg-no-repeat";
// The pointer right-clicks the icon at 500, where the menu's right edge stands. WinUI centres a
// tooltip above the pointer, and Check for updates' row puts each row above it 32 higher.
const pointer = submenu
  ? updates
    ? "-translate-x-54 -translate-y-195"
    : "-translate-x-54 -translate-y-163"
  : updates
    ? "demo-start:-translate-x-180 demo-start:-translate-y-240 demo-row:-translate-x-154 demo-row:-translate-y-350"
    : "demo-start:-translate-x-180 demo-start:-translate-y-240 demo-row:-translate-x-154 demo-row:-translate-y-318";
const rowTip = updates ? "bottom-387" : "bottom-355";
// a live tooltip sits where live/tooltip.ts puts it: centred over the pointer or its owner
const tipAt = "absolute top-(--y) left-(--x) z-4 -mt-8 -translate-x-1/2 -translate-y-full";
const shell = shellTip(trayTip(after)).split("\n");
const accounts = toolsOn("windows").flatMap(([tool]) =>
  after.accounts.filter((a) => a.tool === tool),
);
---

<Root
  id={prefix}
  class:list={["desk block desk-px-720", updates ? "h-572" : "h-540"]}
  data-demo-desk={demo ? "" : undefined}
  inert
  data-output
>
  <Terminal
    class="top-14 bottom-62 left-14 w-600 [&_.elbow]:mr-3 [&_.elbow]:ml-1 [&_.elbow]:size-9 [&_.elbow]:align-[calc(var(--spacing)*4)]"
  >
    <Fragment slot="title">
      <svg class="size-10 shrink-0 fill-none stroke-current" viewBox="0 0 10 10" stroke-width="1.3">
        <path d="M5 0v10M0 5h10M1.5 1.5l7 7m0-7-7 7"></path>
      </svg>
      Claude Code
    </Fragment>
    {session.map((line) => (
      <div set:html={line} />
    ))}
    <div class={rule}></div>
    <div>&gt; <span class="bg-win-term-text"> </span></div>
    <div class={rule}></div>
    <div set:html={`  ${status}`} />
  </Terminal>
  <Taskbar time={hm(clock.menuBar)} date={shortDate(clock.menuBar)}>
    <TrayItem
      on
      id={icon}
      name={shellTip(trayTip(after))}
      level={menuBarLevel(after)}
      was={demo ? menuBarLevel(moments.before) : undefined}
      levels={live}
      class={[
        demo ? "demo-shut:bg-transparent demo-reach:bg-win-subtle" : "",
        live
          ? "data-[state=closed]:bg-transparent data-[state=closed]:hover:bg-win-subtle live:cursor-default"
          : "",
      ]
        .filter(Boolean)
        .join(" ")}
    />
  </Taskbar>
  <IconMenu
    class="absolute right-(--right) bottom-48 z-3 [--right:calc(var(--spacing)*220)]"
    prefix={prefix}
    owner={icon}
    demo={demo}
    live={live}
    updates={updates}
    submenu={submenu}
  />
  {demo && <Tooltip
    id={`${prefix}-tip`}
    class:list={["absolute left-346 z-3 hidden -translate-x-1/2 demo-hl:block", rowTip]}
    >{accountTip("work", moments.before)}</Tooltip
  >}
  {/* the Shell's tooltip, which names the icon */}
  {demo && <Tooltip
    class="absolute bottom-56 left-500 z-3 hidden -translate-x-1/2 demo-reach:block data-[state=shown]:block"
    aria-hidden="true"
    data-part="shell-tip"
    >{shell.map((line) => <span class="block" data-part="line">{line}</span>)}</Tooltip
  >}
  {/* WinUI's tooltip of each account in the menu, its UI Automation help text */}
  {live && <div data-part="tips">
    {accounts.map((a) => <Tooltip class={tipAt} id={`${prefix}-tip-${a.id}`} hidden>
      {menuLine(a, after, "windows")}
    </Tooltip>)}
    <template data-part="tip">
      <Tooltip class={tipAt} hidden />
    </template>
  </div>}
  <svg
    aria-hidden="true"
    class:list={[
      "pointer-events-none absolute bottom-8 left-500 z-4 h-21 w-13 data-[state=gone]:opacity-0 origin-[1px_1px] transition-transform duration-800 ease-out",
      { "demo-pick:scale-86 demo-pick:duration-100": demo },
      pointer,
    ]}
    viewBox="0 0 13 21"
    data-part={live ? "pointer" : undefined}
  >
    <path
      class="fill-white stroke-black"
      d="M.5.5v17.6l4.3-4.2 2.9 6.7 2.6-1.1-2.9-6.6h6Z"
      stroke-width="1"
      stroke-linejoin="round"
    ></path>
  </svg>
</Root>

<script>
  import "../../../scripts/live/tray.ts";
</script>
