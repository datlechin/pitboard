---
// ActivityPage.xaml under 720 pixels of page, where each change stacks under its date, under
// Settings. With live/activity.ts it reads the page's log as the page does: when it shows, and on
// Refresh. Its title's id starts `prefix`.
import PageHeader from "./PageHeader.astro";
import { SETTINGS, activityPage as page } from "../../../data/windows.ts";

interface Props {
  prefix: string;
}
const { prefix } = Astro.props;
---

<div>
  <PageHeader
    prefix={`${prefix}-activity`}
    title={page.title}
    under={[SETTINGS, "settings"]}
    commands={[["fl-refresh", page.command, "read"]]}
  />
  <div class="mt-24 px-24 pb-16" data-part="log">
    {page.rows.map((r) => <div
      class="grid grid-cols-[auto_1fr] gap-x-12 gap-y-2 py-8 pr-12 pl-16 whitespace-nowrap"
    >
      <span class="col-span-2 text-u-12/16 text-win-text-2 tabular-nums">{r.date}</span>
      <b class="font-semibold">{r.change}</b>
      <span>{r.account}</span>
      <span class="text-win-text-2">{r.result}</span>
      <span class="text-win-text-2">{r.by}</span>
    </div>)}
  </div>
</div>
