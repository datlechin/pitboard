---
// A tooltip: 4 pixel corners and the flyout's shadow at a tooltip's elevation.
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"span">;
const { class: extra, ...rest } = Astro.props;
---

<span
  class:list={[
    "rounded-u-4 bg-win-flyout px-8 pt-5 pb-7 font-win text-u-12/16 whitespace-nowrap text-win-text shadow-win-tip",
    extra,
  ]}
  role="tooltip"
  {...rest}
>
  <slot />
</span>
