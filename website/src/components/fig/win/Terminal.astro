---
// Windows Terminal in its dark theme and the Campbell scheme, Cascadia Mono at 12 point and alone 80
// columns wide; intense text is bright. Output colours spans g, y, r, dim, and br bright red.
import CaptionButtons from "./CaptionButtons.astro";

interface Props {
  // what the tab says, unless a `title` slot draws it
  title?: string;
  // a shell's window keeps its output as a log its tab names; live, it grows with its output to
  // Windows Terminal's 30 rows, then scrolls
  id?: string;
  solo?: boolean;
  class?: string;
}
const { title, id, solo = false, class: extra } = Astro.props;
const button = "flex h-32 items-center justify-center";
---

<div
  class:list={[
    "z-1 flex flex-col overflow-hidden rounded-u-8 bg-win-term-bg font-win text-white shadow-win-window",
    solo ? "relative w-788" : "absolute",
    extra,
  ]}
>
  <div class="flex h-40 flex-none items-end bg-win-term-bar pl-8 text-u-12/16">
    <span class="flex h-32 w-200 items-center gap-8 rounded-t-u-8 bg-win-term-bg px-10">
      <svg class="size-16 shrink-0"><use href="#fl-console"></use></svg>
      <span class="flex min-w-0 flex-1 items-center gap-4 truncate" id={id && `${id}-title`}
        ><slot name="title">{title}</slot></span
      >
      <svg class="size-12 shrink-0"><use href="#fl-dismiss"></use></svg>
    </span>
    <span class:list={[button, "w-40"]}
      ><svg class="size-16"><use href="#fl-add"></use></svg></span
    >
    <span class:list={[button, "w-32"]}
      ><svg class="size-12"><use href="#fl-chevron-down"></use></svg></span
    >
    <span class="ml-auto self-start" aria-hidden="true"><CaptionButtons height={40} /></span>
  </div>
  <div
    class:list={[
      "flex min-h-0 flex-1 flex-col overflow-hidden p-8 font-win-mono text-u-16/20 whitespace-pre text-win-term-text ligatures-none *:min-h-20 [&_.dim]:text-win-term-dim [&_.g]:text-win-term-green [&_.r]:text-win-term-red [&_.y]:text-win-term-yellow [&_b]:font-normal [&_b]:text-win-term-bright [&_.br]:text-win-term-bright-red [&_b.r]:text-win-term-bright-red",
      solo
        ? "justify-start *:whitespace-pre-wrap live:max-h-[calc(30lh+var(--spacing)*8)] live:min-h-(--min) live:overflow-y-auto live:select-text"
        : "justify-end",
    ]}
    role={id ? "log" : undefined}
    aria-labelledby={id && `${id}-title`}
  >
    <slot />
  </div>
</div>
