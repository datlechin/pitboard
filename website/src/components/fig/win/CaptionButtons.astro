---
// Minimise, maximise and close, each 46 pixels wide and as tall as its bar, drawn in 1 pixel lines.
interface Props {
  height: 32 | 40 | 48;
}
const { height } = Astro.props;
const tall = { 32: "h-32", 40: "h-40", 48: "h-48" };
const button = ["flex w-46 items-center justify-center", tall[height]];
const glyph = "size-10 fill-none stroke-current";
---

<span class="flex">
  <span class:list={button}>
    <svg class={glyph} viewBox="0 0 10 10"><path d="M0 5.5h10"></path></svg>
  </span>
  <span class:list={button}>
    <svg class={glyph} viewBox="0 0 10 10">
      <rect x=".5" y=".5" width="9" height="9" rx="1"></rect>
    </svg>
  </span>
  <span class:list={button}>
    <svg class={glyph} viewBox="0 0 10 10"><path d="m.5.5 9 9m0-9-9 9"></path></svg>
  </span>
</span>
