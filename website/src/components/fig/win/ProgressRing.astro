---
// WinUI's indeterminate ProgressRing: an accent arc going round its track's place. Narrator names
// it by `label`; it does not turn under reduced motion.
interface Props {
  label?: string;
  class?: string;
}
const { label, class: extra } = Astro.props;
---

<svg
  class:list={["shrink-0 animate-spin text-win-accent", extra]}
  viewBox="0 0 16 16"
  fill="none"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  <circle
    cx="8"
    cy="8"
    r="7"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-dasharray="14 30"
  />
</svg>
