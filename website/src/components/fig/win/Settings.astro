---
// The Pitboard window on its Settings page, scrolled to Limits: When a limit reaches, open on its
// share, or Warm up limits, open on its hours and accounts, as LimitsSections.astro draws them. A
// working window keeps the size its tallest needs.
import Accounts from "./Accounts.astro";
import LimitsSections from "./LimitsSections.astro";
import { settingsPage as page } from "../../../data/windows.ts";

interface Props {
  prefix: string;
  show: "switch" | "warm";
}
const { prefix, show } = Astro.props;
---

<Accounts prefix={prefix} moment="after" pane="settings">
  <div slot="settings">
    <div class="px-24 text-u-28/36 font-semibold">{page.title}</div>
    <div class:list={["mt-24 px-24 pb-24", { "live:min-h-282": show === "switch" }]}>
      <div class="ml-1 pb-6 font-semibold">{page.section}</div>
      <LimitsSections prefix={prefix} show={show} />
    </div>
  </div>
  {show === "warm" && <LimitsSections slot="desk" prefix={prefix} show="warm" flyouts />}
</Accounts>
