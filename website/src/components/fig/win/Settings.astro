---
// SettingsPage.xaml scrolled to Limits: When a limit reaches, open on its share, or Warm up limits,
// open on its hours and accounts.
import ComboBox from "./ComboBox.astro";
import NumberBox from "./NumberBox.astro";
import TimePicker from "./TimePicker.astro";
import Toggle from "./Toggle.astro";
import Window from "./Window.astro";
import { settingsPage as page } from "../../../data/windows.ts";

interface Props {
  show: "switch" | "warm";
}
const { show } = Astro.props;
const caption = "text-u-12/16 text-win-text-2";
const header =
  "flex min-h-68 items-center gap-16 rounded-t-u-4 bg-win-card p-16 inset-shadow-win-layer-edge";
// DefaultSettingsExpanderItemStyle's card, the last one rounded at the foot
const item = "flex items-center gap-16 bg-win-card-2 py-8 pr-44 pl-58 inset-shadow-win-layer-edge";
---

<Window pane="settings">
  <div class="px-24 text-u-28/36 font-semibold">{page.title}</div>
  <div class="mt-24 px-24 pb-24">
    <div class="ml-1 pb-6 font-semibold">{page.section}</div>
    {show === "switch" && (
      <>
        <div class={header}>
          <span class="min-w-0 flex-1">
            <span class="block">{page.atLimit.header}</span>
            <span class:list={["block", caption]}>{page.atLimit.standing}</span>
            <span class:list={["block", caption]}>{page.atLimit.note}</span>
            <span class:list={["block", caption]}>{page.atLimit.terms}</span>
            <span class:list={["block", caption, "text-win-accent-text"]}>{page.atLimit.link}</span>
          </span>
          <ComboBox value={page.atLimit.choice} />
          <span class="flex size-32 shrink-0 items-center justify-center rounded-u-4"
            ><svg class="size-12"><use href="#fl-chevron-up"></use></svg></span
          >
        </div>
        <div class:list={[item, "rounded-b-u-4"]}>
          <span class="min-w-0 flex-1">
            <span class="block">{page.share.header}</span>
            <span class:list={["block", caption]}>{page.share.range}</span>
          </span>
          <NumberBox value={page.share.value} />
        </div>
      </>
    )}
    {show === "warm" && (
      <>
        <div class={header}>
          <span class="min-w-0 flex-1">
            <span class="block">{page.warm.header}</span>
            <span class:list={["block", caption]}>{page.warm.range}</span>
            <span class:list={["block", caption]}>{page.warm.standing}</span>
          </span>
          <span class="flex size-32 shrink-0 items-center justify-center rounded-u-4"
            ><svg class="size-12"><use href="#fl-chevron-up"></use></svg></span
          >
        </div>
        {page.warm.hours.map(([name, at]) => <div class:list={[item, "min-h-48"]}>
          <span class="min-w-0 flex-1">{name}</span>
          <TimePicker at={at} />
        </div>)}
        {page.warm.accounts.map((a, i) => <div
          class:list={[item, "min-h-48", { "rounded-b-u-4": i === page.warm.accounts.length - 1 }]}
        >
          <span class="min-w-0 flex-1">
            <span class="block">{a.title}</span>
            {a.standing && <span class:list={["block", caption]}>{a.standing}</span>}
          </span>
          <Toggle on={a.on} />
        </div>)}
      </>
    )}
  </div>
</Window>
