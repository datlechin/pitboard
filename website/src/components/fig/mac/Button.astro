---
// A push button as macOS 27 draws it: 24 points tall, flat, its corners 6.
interface Props {
  default?: boolean;
}
const { default: main = false } = Astro.props;
---

<span
  class:list={[
    "inline-flex h-24 items-center rounded-u-6 px-13 text-u-13 whitespace-nowrap",
    main ? "bg-mac-window-blue text-white" : "bg-mac-window-btn",
  ]}
  ><slot
/></span>
