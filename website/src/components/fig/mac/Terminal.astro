---
// Terminal's Basic profile, 11 point and alone 80 columns wide; output colours spans g, y, r, dim.
// A shell's window, given its `id`, keeps its output as a log its title names.
import Lights from "./Lights.astro";

interface Props {
  title: string;
  id?: string;
  solo?: boolean;
  class?: string;
}
const { title, id, solo = false, class: extra } = Astro.props;
---

<div
  class:list={[
    "z-1 flex flex-col overflow-hidden rounded-u-12 bg-mac-term-bg shadow-mac-term",
    solo ? "relative w-552" : "absolute",
    extra,
  ]}
>
  <div
    class="relative flex h-28 flex-none items-center bg-mac-term-bar px-10 font-semibold text-mac-term-title inset-shadow-mac-term-b"
  >
    <Lights /><span
      class="pointer-events-none absolute inset-x-0 text-center"
      id={id && `${id}-title`}
      >{title}</span
    >
  </div>
  <div
    class:list={[
      "flex min-h-0 flex-1 flex-col overflow-hidden font-mono whitespace-pre text-mac-term-text ligatures-none [&_.dim]:text-mac-term-dim [&_.g]:text-mac-term-green [&_.r]:text-mac-term-red [&_.y]:text-mac-term-yellow [&_b]:text-mac-term-bold",
      solo
        ? "justify-start px-12 pt-8 pb-10 text-u-11/16 *:min-h-16 *:whitespace-pre-wrap"
        : "justify-end px-10 pb-7 text-u-11/14 *:min-h-14",
    ]}
    role={id ? "log" : undefined}
    aria-labelledby={id && `${id}-title`}
  >
    <slot />
  </div>
</div>
