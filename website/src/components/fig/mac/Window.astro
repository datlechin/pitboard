---
// The Accounts window as AccountsWindow.swift lays it out at its default 840 by 560, the list
// beside the 280 point inspector, as macOS 27 draws it, under the menu bar Pitboard puts up while
// the window is in front; a `crop` desk shows the window's top, a `fit` one all of it. Its
// toolbar's buttons are named as their Labels name them, and ids start `prefix`. The `list` and
// `inspector` slots hold the window's two columns, and the `desk` slot what the window opens over
// the desk: its shortcut menu and its sheets. With `templates`, the menu bar's menus are drawn here
// for every window's.
import About from "./About.astro";
import AccountWindow from "./AccountWindow.astro";
import AppMenuBar from "./AppMenuBar.astro";
import Lights from "./Lights.astro";
import { clock } from "../../../data/world.ts";
import { INSPECTOR } from "../../../data/window.ts";
import { menuBarClock } from "../../../lib/words.ts";

interface Props {
  prefix: string;
  // what the title says under it
  updated: string;
  crop?: boolean;
  fit?: boolean;
  templates?: boolean;
  // the release the About panel names, where the templates are drawn
  version?: string;
}
const { prefix, updated, crop = false, fit = false, templates = false, version = "" } = Astro.props;
// the toolbar's buttons share one piece of glass, and a button alone is a circle
const glass = "flex h-36 items-center rounded-pill bg-mac-window-glass shadow-mac-glass";
const tool = "flex w-34.5 justify-center live:cursor-default live:disabled:opacity-35";
---

<pb-mac-accounts
  id={prefix}
  class:list={[
    "desk [anchor-name:var(--desk)] [--units:880]",
    crop ? "block h-348" : "flex items-center justify-center pt-44 pb-20",
    { "min-h-600": !crop && !fit },
  ]}
  inert
  data-output
>
  <AppMenuBar prefix={prefix} clock={menuBarClock(clock.menuBar)} templates={templates} />
  <div
    class:list={[
      "group/window grid min-h-220 w-840 grid-cols-[1fr_calc(var(--spacing)*280)] overflow-hidden rounded-u-16 [anchor-name:var(--window)] bg-mac-window-bg text-mac-window-text shadow-mac-window data-[state=collapsed]:grid-cols-[1fr_0]",
      crop ? "absolute top-24 left-1/2 -translate-x-1/2" : "relative",
      { "min-h-540": !crop && !fit },
    ]}
    data-part="window"
  >
    <Lights window class="top-19 left-19" />
    <div class="flex min-h-0 min-w-0 flex-col">
      <div
        class="flex h-52 flex-none items-center pr-8 pl-92 group-data-[state=collapsed]/window:pr-52"
      >
        <span class="flex flex-1 flex-col pb-2.5 text-mac-window-title"
          ><b class="text-u-13/16 font-bold" id={`${prefix}-title`}>Accounts</b
          ><span class="text-u-11/13 text-mac-window-sub" data-part="updated">{updated}</span></span
        >
        <span class:list={[glass, "px-2"]}>
          <button class={tool} type="button" aria-label="Refresh" data-does="refresh">
            <svg class="size-22 shrink-0"><use href="#sf-refresh"></use></svg>
          </button>
          <button class={tool} type="button" aria-label="Add Account" data-does="add">
            <svg class="size-22 shrink-0"><use href="#sf-plus"></use></svg>
          </button>
        </span>
      </div>
      <div class="min-h-0 flex-1 pb-10" data-part="list">
        <slot name="list" />
      </div>
    </div>
    {/* the inspector, shown at first, under the toolbar's button that shows and hides it */}
    <div
      class="relative min-w-0 overflow-hidden bg-mac-window-inspector pt-52 shadow-[inset_calc(var(--spacing)*1)_0_var(--color-mac-window-sep)] group-data-[state=collapsed]/window:invisible"
      id={`${prefix}-inspector`}
    >
      <slot name="inspector" />
    </div>
    <button
      class:list={[
        glass,
        "absolute top-8 right-8 z-1 w-36 justify-center focus-mac live:cursor-default",
      ]}
      type="button"
      aria-label={INSPECTOR}
      aria-controls={`${prefix}-inspector`}
      aria-expanded="true"
      aria-keyshortcuts="Control+Meta+I"
      data-does="inspector"
    >
      <svg class="size-20 shrink-0 -scale-x-100"><use href="#sf-sidebar"></use></svg>
    </button>
    {/* what macOS 26 draws over a window with a sheet or an alert up */}
    <div class="absolute inset-0 z-1 bg-mac-window-scrim" data-part="smoke" hidden></div>
  </div>
  <slot name="desk" />
  {templates && (
    <>
      <template data-part="about"><About version={version} /></template>
      <template data-part="account-window"><AccountWindow /></template>
    </>
  )}
</pb-mac-accounts>

<script>
  import "../../../scripts/live/mac-accounts.ts";
</script>
