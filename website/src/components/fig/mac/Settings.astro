---
// The top of the Limits pane as macOS 27 draws it, in the words machine.rs gives
// LimitsSettings.swift; each height cuts the window 8 points below its first group. Its controls
// carry the names machine.rs gives them, and their ids start `prefix`.
import Lights from "./Lights.astro";
import Switch from "./Switch.astro";
import { clock } from "../../../data/world.ts";
import { hm } from "../../../lib/words.ts";

interface Props {
  prefix: string;
  show: "switch" | "warm";
}
const { prefix, show } = Astro.props;
const tabs = [
  ["general", "General", "sf-gear"],
  ["limits", "Limits", "sf-gauge"],
  ["advanced", "Advanced", "sf-gear2"],
];
const heights = { switch: "h-245", warm: "h-378.5" } as const;
const choice = "Switch Automatically";
const head = "pt-28 pb-11.5 pl-30 font-bold";
const group = "mx-20 rounded-u-12 bg-mac-window-group";
// each row's label sits 18 points down its middle; a rule 10 points short of each side tops
// every row but the first
const row = "relative flex px-10";
const ruled =
  "pt-1 before:absolute before:inset-x-10 before:top-0 before:h-1 before:bg-mac-window-rule";
const small = "block text-u-12/15 text-mac-window-sub";
const field = "shadow-[inset_0_0_0_calc(var(--spacing)*1)_var(--color-mac-window-control)]";
const time = "shadow-[inset_0_0_0_calc(var(--spacing)*1)_var(--color-mac-window-sep)]";
---

<pb-settings id={prefix} class:list={["desk block", heights[show]]} inert data-output>
  <div
    class="absolute top-24 left-1/2 w-500 -translate-x-1/2 overflow-hidden rounded-u-16 bg-mac-window-bg text-mac-window-text shadow-mac-window"
  >
    <div class="relative flex h-80 justify-center gap-0.5 pt-32">
      <Lights window closeOnly class="top-9.5 left-8.75" />
      <span class="absolute inset-x-0 top-6 text-center font-bold text-mac-window-title"
        >Limits</span
      >
      {tabs.map(([id, name, icon]) => <span
        class:list={[
          "flex h-48 min-w-55.5 flex-col items-center px-7 pt-2 text-u-11/13",
          id === "limits"
            ? "rounded-[calc(var(--spacing)*7)] bg-mac-window-group text-mac-window-blue shadow-mac-glass"
            : "text-mac-window-sub",
        ]}
      >
        <svg class="-mb-1.5 mt-1.5 size-27 shrink-0 [--stroke:1.1]">
          <use href={`#${icon}`} />
        </svg>
        {name}
      </span>)}
    </div>
    <div class="pb-20">
      {show === "switch" && (
        <>
          <p class={head}>Before an account runs out</p>
          <div class={group}>
            <div class:list={[row, "h-40.5 items-center pr-14 pb-4.5"]}>
              <span class="flex-1">When a limit reaches</span>
              {/* drawn: an input's text sits lower in its box than macOS draws it */}
              <span
                class:list={[
                  "flex h-25.5 w-57.5 items-center justify-end rounded-u-6 bg-mac-window-bg pr-7.5 tabular-nums",
                  field,
                ]}
                >95%</span
              >
              <svg
                class="ml-7.5 h-24 w-19.5 shrink-0 rounded-u-5 bg-mac-window-control"
                role="spinbutton"
                aria-label="Share of a limit"
                aria-valuenow="95"
                aria-valuemin="50"
                aria-valuemax="99"
                viewBox="0 0 19.5 24"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5.4 8.1 10 3.4l4.6 4.7M5.4 15.4l4.6 4.7 4.6-4.7" stroke-width="1.75" />
                <path d="M3.5 11.75h12.5" stroke-opacity=".16" />
              </svg>
              {/* a pop-up button, which says its choice as a select-only combobox does */}
              <span
                class="flex items-center"
                role="combobox"
                aria-label="When a limit reaches 95%"
                aria-haspopup="listbox"
                aria-expanded="false"
              >
                <span class="ml-21.5 whitespace-nowrap">{choice}</span>
                <span
                  class="ml-12.5 flex size-19.5 flex-none items-center justify-center rounded-circle bg-mac-window-control"
                  aria-hidden="true"
                >
                  <svg class="size-19 shrink-0"><use href="#sf-updown"></use></svg>
                </span>
              </span>
            </div>
            <div class:list={[row, ruled, "h-37 items-center pb-1.5"]}>
              <span class={small}
                >Watching work: 40% of its weekly limit, as of {hm(clock.read)}.</span
              >
            </div>
          </div>
        </>
      )}
      {show === "warm" && (
        <>
          <p class={head}>Warm up limits</p>
          <div class={group}>
            {[
              ["From", "07:00"],
              ["To", "23:00"],
            ].map(([label, at], i) => <div
              class:list={[row, "items-center pb-3", i === 0 ? "h-39" : [ruled, "h-40"]]}
            >
              <span class="flex-1">{label}</span>
              <span
                class:list={["flex h-22 w-61 items-center rounded-u-6 pl-3.5 tabular-nums", time]}
                >{at}<svg
                  class="mr-3.5 ml-auto h-22 w-13.5 shrink-0"
                  viewBox="0 0 13.5 22"
                  fill="none"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M3.75 7 6.75 4l3 3M.5 10.75h12.5M3.75 14l3 3 3-3" />
                </svg></span
              >
            </div>)}
            <div class:list={[row, ruled, "h-56.5 items-start pt-11"]}>
              <span class="flex-1" id={`${prefix}-personal`}>
                personal · Max
                20x<small class:list={[small, "mt-3"]}
                  >Warms up again at {hm(clock.warmsAgain)}</small
                >
              </span>
              <Switch on aria-labelledby={`${prefix}-personal`} />
            </div>
            <div class:list={[row, ruled, "h-38.5 items-center pb-1.5"]}>
              <span class="flex-1" id={`${prefix}-work`}>work · Max 20x</span>
              <Switch aria-labelledby={`${prefix}-work`} />
            </div>
            <div class:list={[row, ruled, "h-37 items-center pb-1.5"]}>
              <span class={small}>Next warm-up: personal at {hm(clock.warmsAgain)}.</span>
            </div>
          </div>
        </>
      )}
    </div>
  </div>
</pb-settings>
