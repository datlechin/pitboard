---
// The notification once a limit reaches the share (MacPlatform.swift); macOS cuts a title longer
// than the banner's one line at its end. The banner is a group its title names.
import MenuBar from "./MenuBar.astro";
import MenuItem from "./MenuItem.astro";
import { clock, share } from "../../../data/world.ts";
import { headsUp, menuBarClock } from "../../../lib/words.ts";

interface Props {
  prefix: string;
}
const { prefix } = Astro.props;
---

<pb-notice id={prefix} class="desk block h-160" inert data-output>
  <MenuBar clock={menuBarClock(clock.warned)}>
    <MenuItem
      button
      aria-label={`Pitboard, ${headsUp.account} ${share}%, ${headsUp.tool}`}
      aria-haspopup="menu"
      aria-expanded="false"
    >
      <svg class="size-16 shrink-0"><use href="#pb-template"></use></svg>
      {`${headsUp.account} ${share}%`}
    </MenuItem>
  </MenuBar>
  <div
    class="absolute top-36 right-14 flex w-370 items-center gap-10 rounded-u-18 bg-mac-menu-bg p-12 text-mac-menu-text shadow-mac-banner backdrop-blur-xl backdrop-saturate-180"
    role="group"
    aria-labelledby={`${prefix}-title`}
  >
    <img class="size-38 flex-none" src="/icon-192.png" alt="" width="38" height="38" />
    <span class="min-w-0 flex-1 text-u-13/16">
      <b class="flex gap-6 font-bold whitespace-nowrap"
        ><span class="min-w-0 truncate" id={`${prefix}-title`}>{headsUp.title}</span
        ><span class="ml-auto text-u-12 font-normal text-mac-menu-sub">now</span></b
      >
      {headsUp.tool}<br />{headsUp.body}
    </span>
    <button
      class="flex flex-none items-center self-stretch pl-10 font-medium inset-shadow-mac-menu-l"
      type="button"
    >
      {headsUp.button}
    </button>
  </div>
</pb-notice>
