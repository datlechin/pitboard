---
// AccountRow.swift, UsageBar.swift, and NoticeRow.swift for the notice a switch leaves.
import Button from "./Button.astro";
import Window from "./Window.astro";
import { clock, tools, type Moment, type Tool } from "../../../data/world.ts";
import { isInUse, level, listed, paceText, runsOutNote, standing } from "../../../lib/words.ts";

interface Props {
  moment: Moment;
  crop?: boolean;
  // one tool's section alone, as the pane scrolled to it shows it
  only?: Tool;
}
const { moment, crop = false, only } = Astro.props;
const shown = only ? tools.filter(([tool]) => tool === only) : tools;
const capitalised = (s: string) => s[0].toUpperCase() + s.slice(1);
const warm: Record<string, string> = { personal: `Warms up again at ${clock.warmsAgain}` };
const fill = { g: "fill-mac-window-green", y: "fill-mac-window-orange", r: "fill-mac-window-red" };
const mark = { under: "fill-mac-window-green", over: "fill-mac-window-red" };
const sub = "text-u-12/15 text-mac-window-sub";
---

<Window
  pane="accounts"
  title="Accounts"
  subtitle={`Updated ${clock.read}`}
  tools={["sf-refresh", "sf-plus"]}
  crop={crop}
  fit={only !== undefined}
>
  {crop && <div class="flex items-start gap-6 pt-10 pb-8 inset-shadow-mac-window-b">
    <svg class="mt-1 size-15 shrink-0 text-mac-window-sub">
      <use href="#sf-info-fill" />
    </svg>
    <span class="flex-1">
      <b class="block font-medium">Switched Claude Code to work</b>
      <span class="text-u-12/15 text-mac-window-sub tabular-nums"
        >Claude Code sessions already open follow in 0:21</span
      >
    </span>
    <svg class="mt-3 size-11 shrink-0 text-mac-window-sub">
      <use href="#sf-xmark" />
    </svg>
  </div>}
  {shown.map(([tool, name], t) => (
    <>
      <div
        class:list={[
          "pb-8 text-u-11/13 font-bold text-mac-window-sub inset-shadow-mac-window-b",
          t === 0 ? "pt-7" : "pt-27",
        ]}
      >
        {name}
      </div>
      {listed(tool, moment).map((a) => {
        const on = isInUse(a, moment);
        const notes = [
          on && a.read && `Read ${a.read} ago, with Claude closed`,
          runsOutNote(a, moment) && capitalised(runsOutNote(a, moment)!),
          !on && a.parked && `Parked login good for ${a.parked.app}`,
          !on && a.lapses && `Its sign-in may lapse in ${a.lapses.app}`,
          warm[a.label] && tool === "claude" ? warm[a.label] : null,
        ].filter(Boolean);
        // each row's rule starts under its name
        return <div class="ml-34 pt-13 pb-7 inset-shadow-mac-window-b">
          <div class="-ml-34 flex items-center gap-8">
            <svg
              class:list={[
                "h-22 w-26 shrink-0",
                on ? "text-mac-window-blue" : "text-mac-window-sub",
              ]}
            >
              <use href={on ? "#sf-person-fill" : "#sf-person"} />
            </svg>
            <span class="flex min-w-0 flex-1 flex-col gap-2">
              <span class="flex items-center gap-6 font-medium">
                {a.label}
                {a.plan && <span
                  class="rounded-pill bg-mac-window-track px-6 py-1 text-u-10/14 font-normal text-mac-window-sub"
                  >{a.plan}</span
                >}
              </span>
              {a.email && <span class={sub}>{a.email}</span>}
            </span>
            {on ? (
              <span class="flex items-center gap-3 text-u-12 text-mac-window-sub">
                <svg class="size-12 shrink-0">
                  <use href="#sf-check" />
                </svg>
                In Use
              </span>
            ) : (
              <Button>Use</Button>
            )}
          </div>
          {a.limits.length > 0 && <div
            class="mt-8 grid grid-cols-[auto_1fr_auto_auto_auto] items-center gap-x-8 gap-y-6 text-u-12/15 tabular-nums"
          >
            {a.limits.map((l) => {
              const s = standing(l);
              return (
                <>
                  <span class="text-mac-window-sub">{l.kind}</span>
                  <svg
                    class="h-16 w-full overflow-visible"
                    viewBox="0 0 100 16"
                    preserveAspectRatio="none"
                  >
                    <rect class="fill-mac-window-track" width="100" height="16" rx="2.4" ry="2.5" />
                    {l.used > 0 && (
                      <rect
                        class={fill[level(l.used)]}
                        width={l.used}
                        height="16"
                        rx="2.4"
                        ry="2.5"
                      />
                    )}
                    <rect
                      class="fill-none stroke-mac-window-gauge-edge stroke-[calc(var(--spacing)*0.5)]"
                      width="100"
                      height="16"
                      rx="2.4"
                      ry="2.5"
                      vector-effect="non-scaling-stroke"
                    />
                    {s !== null && s !== "even" && (
                      <>
                        <rect
                          class="fill-mac-window-bg"
                          x={l.even! - 2}
                          y="-3"
                          width="4"
                          height="22"
                          rx="2"
                          ry="2"
                        />
                        <rect
                          class={mark[s]}
                          x={l.even! - 1}
                          y="-3"
                          width="2"
                          height="22"
                          rx="1"
                          ry="1"
                        />
                      </>
                    )}
                  </svg>
                  <span class="min-w-38 text-right">{l.used}%</span>
                  <span class="min-w-110 text-right text-mac-window-sub">resets in {l.resets}</span>
                  <span
                    class:list={[
                      "min-w-100",
                      // UsageBar.swift tints only over pace
                      s === "over" ? "text-mac-window-red" : "text-mac-window-sub",
                    ]}
                    >{paceText(l)}</span
                  >
                </>
              );
            })}
          </div>}
          {notes.map((n) => <p class:list={["mt-6", sub]}>{n}</p>)}
        </div>;
      })}
    </>
  ))}
</Window>
