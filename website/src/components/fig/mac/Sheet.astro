---
// A sheet as SheetLayout lays one out in the app (AccountSheetView.swift): 440 points wide, its
// title and message, a grouped form, then a spinner where it waits and its buttons at the end. A
// <dialog> live/dialog.ts opens in the middle of its window, as macOS 26 puts a sheet; its ids
// start `id`.
interface Props {
  id: string;
}
const { id } = Astro.props;
---

<dialog
  class="supports-[anchor-name:--a]:m-0 [position-anchor:var(--over)] supports-[anchor-name:--a]:right-auto supports-[anchor-name:--a]:bottom-auto supports-[anchor-name:--a]:top-[anchor(center)] supports-[anchor-name:--a]:left-[anchor(center)] supports-[anchor-name:--a]:-translate-1/2 w-440 overflow-visible rounded-u-18 bg-mac-window-bg font-mac text-u-13/16 text-mac-window-text shadow-mac-window backdrop:bg-transparent"
  id={id}
  aria-labelledby={`${id}-title`}
  aria-describedby={`${id}-message`}
>
  <form method="dialog">
    <div class="px-20 pt-20">
      <h2 class="font-bold" id={`${id}-title`} data-part="title"></h2>
      <p
        class="mt-6 whitespace-pre-line text-mac-window-sub"
        id={`${id}-message`}
        data-part="message"
      ></p>
    </div>
    <div class="flex flex-col gap-10 px-20 py-14"><slot /></div>
    <div class="flex items-center gap-8 px-20 pb-20">
      <slot name="status" />
      <span class="flex-1"></span>
      <slot name="buttons" />
    </div>
  </form>
</dialog>
