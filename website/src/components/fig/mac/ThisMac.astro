---
// MachinePane.swift: doctor's checks in a grouped form under the line that heads them, each with
// its level's symbol, its name and what it looked at, as data/machine.ts words them. The window
// checks again each time the pane shows, as its `.task` does, and on Check Again: live/machine.ts
// draws the checks then from the state, over these from the snapshot of a healthy Mac.
import doctor from "../../../../../crates/pitboard/src/render/snapshots/pitboard__render__doctor__tests__doctor_on_a_healthy_mac.snap?raw";
import Spinner from "./Spinner.astro";
import { checkedAt, checking, checksOf, spokenLevel } from "../../../data/machine.ts";
import { clock } from "../../../data/world.ts";
import { rowsOf } from "../../../lib/doctor.ts";
import { hm } from "../../../lib/words.ts";

const { lines, summary } = checksOf(rowsOf(doctor));
const symbol = { ok: "sf-check-fill", warn: "sf-warning-fill", fail: "sf-warning-fill" };
---

<div class="px-20 pt-18 pb-20">
  <p class="flex items-baseline gap-8 px-10 pb-8 font-bold">
    <span class="flex-1" data-part="summary">{summary}</span>
    <span class="text-u-12/15 font-normal text-mac-window-sub tabular-nums" data-part="checked"
      >{checkedAt(hm(clock.menuBar))}</span
    >
    <span class="self-center text-mac-window-sub" data-part="checking" hidden>
      <Spinner label={checking("macos")} />
    </span>
  </p>
  <ul class="rounded-u-12 bg-mac-window-group" aria-label={summary} data-part="checks">
    {lines.map((line, i) => <li
      class:list={[
        "group/check relative flex items-start gap-12 px-10 py-9",
        i > 0 &&
          "before:absolute before:inset-x-10 before:top-0 before:h-1 before:bg-mac-window-rule",
      ]}
      data-level={line.level}
    >
      <span class="flex min-w-0 flex-1 items-start gap-6">
        <svg
          class="mt-px size-16 shrink-0 text-mac-window-green group-data-[level=fail]/check:text-mac-window-red group-data-[level=warn]/check:text-mac-window-orange"
          role="img"
          aria-label={spokenLevel[line.level]}
        >
          <use href={`#${symbol[line.level]}`} />
        </svg>
        <span class="min-w-0">
          <span data-part="name">{line.name}</span>
          <span
            class="block text-u-11/14 text-mac-window-sub"
            data-part="advice"
            hidden={!line.advice}
            >{line.advice ?? ""}</span
          >
        </span>
      </span>
      <span
        class="max-w-260 text-right break-words text-mac-window-sub select-text"
        data-part="detail"
        >{line.detail}</span
      >
    </li>)}
  </ul>
</div>
