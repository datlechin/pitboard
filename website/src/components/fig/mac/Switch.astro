---
// A switch on macOS 27: 36 by 16 points, its knob a 21 by 13 point pill; it looks as aria-checked
// says.
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {
  on?: boolean;
}
const { on = false, ...rest } = Astro.props;
---

<button
  class="relative h-16 w-36 flex-none rounded-pill bg-mac-window-fill after:absolute after:top-1.5 after:left-1.5 after:h-13 after:w-21 after:rounded-pill after:bg-white after:shadow-mac-knob aria-checked:bg-mac-window-blue aria-checked:after:right-1.5 aria-checked:after:left-auto"
  type="button"
  role="switch"
  aria-checked={on ? "true" : "false"}
  {...rest}
></button>
