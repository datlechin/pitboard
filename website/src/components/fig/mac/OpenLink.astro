---
// AccountPicker.swift, with crates/pitboard-ffi/src/present/windows.rs's words, under the menu bar
// the app puts up while it is in front. Corners as the main window's; no picture measures its title
// bar. Its controls stay drawn: Open loads claude.ai.
import AppMenuBar from "./AppMenuBar.astro";
import Lights from "./Lights.astro";
import Button from "./Button.astro";
import { clock } from "../../../data/world.ts";
import { menuBarClock } from "../../../lib/words.ts";

interface Props {
  prefix: string;
}
const { prefix } = Astro.props;
const account = "rounded-u-5 pt-4 px-8 pb-5";
---

<pb-account-picker
  id={prefix}
  class="desk flex min-h-300 items-center justify-center pt-44 pb-20"
  inert
  data-output
>
  <AppMenuBar prefix={prefix} clock={menuBarClock(clock.menuBar)} room="clock" />
  <div
    class="relative w-440 overflow-hidden rounded-u-16 bg-mac-window-bg text-mac-window-text shadow-mac-window"
  >
    <div class="relative h-28 bg-mac-window-side">
      <Lights window class="top-7 left-12" />
      <span class="pointer-events-none absolute inset-x-0 top-6 text-center font-bold"
        >Open Link</span
      >
    </div>
    <div class="grid gap-12 p-20">
      <span class="font-bold">Open this claude.ai link as:</span>
      <span class="truncate font-mono text-u-12"
        >claude.ai/project/0199c2f4-8e3b-7a51-b6d0-4f2e9c7a1d38</span
      >
      <div class="rounded-u-6 bg-mac-window-bg p-4 shadow-mac-list">
        <div class={account}>
          personal<small class="block text-u-10/13 text-mac-window-sub">me@example.com</small>
        </div>
        <div class:list={[account, "bg-mac-window-blue text-white"]}>
          work<small class="block text-u-10/13 text-white/80">me@company.com, window open</small>
        </div>
      </div>
      <div class="flex justify-end gap-8">
        <Button button={false}>Cancel</Button>
        <Button button={false} default>Open</Button>
      </div>
    </div>
  </div>
</pb-account-picker>

<script>
  import "../../../scripts/live/picker.ts";
</script>
