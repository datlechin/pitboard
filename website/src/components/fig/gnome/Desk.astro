---
// The hero's desk on stock GNOME 50: the top bar and its date menu, a Claude Code session in Ptyxis
// behind, and over it, with focus, the Pitboard window made short to its header bar and the Claude
// Code groups, with no tray to stand for it. With `demo`, the pointer presses work's Switch and the
// window switches with its spinner, and the status line shows the moment before the switch until
// the demo plays it. Its ids start `prefix`.
import DateMenu from "./DateMenu.astro";
import Ptyxis from "./Ptyxis.astro";
import TopBar from "./TopBar.astro";
import AccountsPage from "../linux/AccountsPage.astro";
import Window from "../linux/Window.astro";
import { topBarClock } from "../../../data/gnome.ts";
import { session } from "../../../data/desk.ts";
import { accountsPage } from "../../../data/linux-window.ts";
import { clock, moments } from "../../../data/world.ts";
import { statusLine } from "../../../lib/words.ts";

interface Props {
  prefix: string;
  demo?: boolean;
}
const { prefix, demo = false } = Astro.props;
const [before, now] = [statusLine(moments.before), statusLine(moments.after)];
const status =
  demo && before !== now
    ? `<span class="hidden demo:inline">${before}</span><span class="demo:hidden" data-part="status">${now}</span>`
    : `<span data-part="status">${now}</span>`;
const rule =
  "bg-linear-to-b from-linux-term-dim to-linux-term-dim bg-size-[100%_1px] bg-position-[0_50%] bg-no-repeat";
// the window as the page starts, before the demo's switch
const window = `${prefix}-window`;
// The pointer comes up from the session to work's Switch, at 668 by 497 on the desk, and rests
// there. It is the site's arrow in the colours of Adwaita's cursors, black inside white.
const pointer = "demo-start:-translate-x-260 demo-start:translate-y-120";
---

<pb-gnome-desk
  id={prefix}
  class="desk block h-680 [anchor-name:var(--desk)] desk-px-800"
  data-demo-desk={demo ? "" : undefined}
  inert
  data-output
>
  <Ptyxis
    backdrop
    class="top-46 bottom-14 left-14 w-520 [&_.elbow]:mr-3 [&_.elbow]:ml-1 [&_.elbow]:size-9 [&_.elbow]:align-[calc(var(--spacing)*4)]"
  >
    <Fragment slot="title">
      {/* the title Claude Code sets, its mark drawn */}
      <svg
        class="mr-6 inline-block size-12 fill-none stroke-current align-[-0.05em]"
        viewBox="0 0 10 10"
        stroke-width="1.3"
        aria-hidden="true"
      >
        <path d="M5 0v10M0 5h10M1.5 1.5l7 7m0-7-7 7"></path>
      </svg
      >Claude Code
    </Fragment>
    {session.map((line) => (
      <div set:html={line} />
    ))}
    <div class={rule}></div>
    <div>&gt; <span class="bg-linux-term-text"> </span></div>
    <div class={rule}></div>
    <div set:html={`  ${status}`} />
  </Ptyxis>
  <Window
    prefix={window}
    updated={accountsPage(moments.before).updated}
    height={520}
    class="absolute top-46 right-14 z-1"
  >
    <AccountsPage
      slot="accounts"
      prefix={window}
      moment="before"
      only="claude"
      demo={demo ? "work" : undefined}
    />
  </Window>
  <TopBar clock={topBarClock(clock.menuBar)} prefix={prefix} />
  <DateMenu prefix={prefix} at={clock.menuBar} />
  {demo && <svg
    aria-hidden="true"
    class:list={[
      "pointer-events-none absolute top-497 left-668 z-4 h-21 w-13 origin-[1px_1px] transition-transform duration-800 ease-out data-[state=gone]:opacity-0",
      "demo-pick:scale-86 demo-pick:duration-100",
      pointer,
    ]}
    viewBox="0 0 13 21"
    data-part="pointer"
  >
    <path
      class="fill-black stroke-white"
      d="M.5.5v17.6l4.3-4.2 2.9 6.7 2.6-1.1-2.9-6.6h6Z"
      stroke-width="1"
      stroke-linejoin="round"
    ></path>
  </svg>}
</pb-gnome-desk>

<script>
  import "../../../scripts/live/gnome-desk.ts";
</script>
