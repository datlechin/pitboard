---
import { commands } from "../data/commands.ts";
import { DOCS } from "../data/site.ts";
import { siteData } from "../lib/data.ts";
import { appZip, windowsMsi } from "../lib/github.ts";
import { platforms, shownOn, type Platform } from "../lib/platform.ts";
import CommandBox from "./CommandBox.astro";
import DownloadButton from "./DownloadButton.astro";
import PlatformTabs from "./PlatformTabs.astro";

interface Props {
  n: number;
  class?: string;
}
const { n, class: extra } = Astro.props;
const { downloads } = await siteData();
const zip = appZip(downloads.macos.release);
const windows = downloads.windows.release;
const tabId = (p: Platform) => `tab-${p}-${n}`;
const panelId = (p: Platform) => `tp-${p}-${n}`;
// each platform's panel to its readers, macOS's without JavaScript
const panel = (p: Platform) => shownOn(p, platforms);
const note = "mt-4 max-w-measure text-note text-pretty text-muted";
const lead = "mt-6 text-note text-fg";
const after = "js:not-data-shown:hidden";
---

<div class={extra}>
  <PlatformTabs label="Install Pitboard" tabId={tabId} panelId={panelId} />
  <div class="flow-root pt-7 no-js:pt-0">
    <div
      class={panel("macos")}
      role="tabpanel"
      id={panelId("macos")}
      aria-labelledby={tabId("macos")}
    >
      <p class={note}>The app needs macOS 14 or later and includes the command line.</p>
      <DownloadButton class="mt-4" platform="macos" href={zip.url} after />
      <p class:list={[note, after]} data-after="macos">
        Move Pitboard to your Applications folder before you open it.
      </p>
      <p class={lead}>For the command line alone, run the install script:</p>
      <CommandBox class="mt-2" command={commands.installScript} />
      <p class={note}>Then <a href={`${DOCS}/quickstart`}>add your accounts</a>.</p>
      <p class:list={[note, "hidden no-js:block"]}>
        Pitboard also runs on <a href="/download#windows">Windows</a> and
        <a href="/download#linux">Linux</a>.
      </p>
    </div>
    <div
      class={panel("windows")}
      role="tabpanel"
      id={panelId("windows")}
      aria-labelledby={tabId("windows")}
    >
      <p class={note}>
        The app needs Windows 11 24H2 or later and includes the command line; Arm PCs take the
        <a href={windowsMsi(windows, "arm64").url} data-download="windows">ARM64 installer</a>.
      </p>
      <DownloadButton
        class="mt-4"
        platform="windows"
        href={windowsMsi(windows, "x64").url}
        beta={windows.prerelease}
        after
      />
      <p class:list={[note, after]} data-after="windows">
        If Windows says it protected your PC, select <b>More info</b>, then <b>Run anyway</b>.
      </p>
      <p class={note}>
        For the command line alone,
        <a href={`${DOCS}/install#install-the-command-line-on-windows`}>install it from its zip</a>.
      </p>
      <p class={note}>Then <a href={`${DOCS}/quickstart`}>add your accounts</a>.</p>
    </div>
    <div
      class={panel("linux")}
      role="tabpanel"
      id={panelId("linux")}
      aria-labelledby={tabId("linux")}
    >
      <p class={note}>The app runs on macOS and Windows, so on Linux, install the command line:</p>
      <CommandBox class="mt-4" command={commands.installScript} />
      <p class={note}>On Linux, Pitboard has not been run with real logins.</p>
      <p class={note}>
        Then <a href={`${DOCS}/quickstart#on-the-command-line`}>add your accounts</a>.
      </p>
    </div>
  </div>
</div>
