---
import { siteData } from "../lib/data.ts";
import { appZip, windowsMsi } from "../lib/github.ts";
import { onOf, type Platform } from "../lib/platform.ts";
import DownloadButton from "./DownloadButton.astro";
import PlatformTabs from "./PlatformTabs.astro";

interface Props {
  n: number;
  // the hero's, whose figures the Linux desktop's choice redraws
  desktop?: boolean;
  class?: string;
}
const { n, desktop, class: extra } = Astro.props;
const { downloads, windowsSigned } = await siteData();
const zip = appZip(downloads.macos.release);
const windows = downloads.windows.release;
const linux = downloads.linux.release;
const unsigned = windowsSigned ? "" : " Pitboard for Windows is not signed yet.";
const tabId = (p: Platform) => `tab-${p}-${n}`;
const panelId = (p: Platform) => `tp-${p}-${n}`;
const line = "mt-3 max-w-measure text-ui text-pretty text-muted";
const after = "mt-3 max-w-measure text-note text-pretty text-fg js:not-data-shown:hidden";
---

<div class={extra}>
  <PlatformTabs label="Install Pitboard" tabId={tabId} panelId={panelId} desktop={desktop} />
  <div class="flow-root pt-7 no-js:pt-0">
    <div
      role="tabpanel"
      data-on={onOf(["macos"])}
      id={panelId("macos")}
      aria-labelledby={tabId("macos")}
    >
      <DownloadButton platform="macos" href={zip.url} after />
      <p class={line}>{`Pitboard ${downloads.macos.release.version} for macOS 14 or later.`}</p>
      <p class={after} data-after="macos">
        Move Pitboard to your Applications folder before you open it.
      </p>
    </div>
    <div
      class="no-js:hidden"
      role="tabpanel"
      data-on={onOf(["windows"])}
      id={panelId("windows")}
      aria-labelledby={tabId("windows")}
    >
      <DownloadButton
        platform="windows"
        href={windowsMsi(windows, "x64").url}
        arm={windowsMsi(windows, "arm64").url}
        beta={windows.prerelease}
        after
      />
      <p class={line}>{`Pitboard ${windows.version} for Windows 11 24H2 or later.${unsigned}`}</p>
      <p class={after} data-after="windows">
        If Windows says it protected your PC, select <b>More info</b>, then <b>Run anyway</b>.
      </p>
    </div>
    <div
      class="no-js:hidden"
      role="tabpanel"
      data-on={onOf(["linux"])}
      id={panelId("linux")}
      aria-labelledby={tabId("linux")}
    >
      <DownloadButton platform="linux" href="/download#linux" />
      <p class={line}>
        {`Pitboard ${linux.version} for Debian 13, Ubuntu 26.04, Fedora 43 and later, or openSUSE Tumbleweed, with GNOME or KDE Plasma.`}
      </p>
    </div>
    <p class="mt-5 text-ui"><a href="/download">Other platforms and the command line</a></p>
  </div>
</div>
