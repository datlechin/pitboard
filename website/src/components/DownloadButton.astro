---
// With `after`, a click shows the step its platform's [data-after] note gives next. With `arm`,
// site.ts gives an Arm PC that file instead.
interface Props {
  platform: "macos" | "windows" | "linux";
  href: string;
  arm?: string;
  beta?: boolean;
  after?: boolean;
  class?: string;
}
const { platform, href, arm, beta = false, after = false, class: extra } = Astro.props;
const text = {
  macos: "Download for Mac",
  windows: "Download for Windows",
  linux: "Install on Linux",
}[platform];
---

<a
  class:list={[
    "inline-flex h-12 cursor-pointer items-center justify-center rounded-sm bg-ink px-6 font-mono text-control font-semibold text-on-ink no-underline hover:bg-[color-mix(in_srgb,var(--color-ink)_84%,var(--color-page))]",
    extra,
  ]}
  href={href}
  data-download={after ? platform : undefined}
  data-arm={arm}
  >{`${text}${beta ? " (beta)" : ""}`}</a
>
