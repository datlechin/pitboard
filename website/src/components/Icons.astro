---
import template from "../assets/logo/template.svg?raw";
import tray from "../../../apps/windows/Icon/icon-16.svg?raw";
import trayPlenty from "../../../apps/windows/Icon/tray-plenty-16.svg?raw";
import trayLow from "../../../apps/windows/Icon/tray-low-16.svg?raw";
import trayOut from "../../../apps/windows/Icon/tray-out-16.svg?raw";
import { bar, fluent, line, symbolic } from "../data/glyphs.ts";

const paths = [...template.matchAll(/<path\b[^>]*?\sd="([^"]+)"/g)];
if (paths.length !== 2) throw new Error("template.svg is not the kit's two paths");
const [board, dim] = paths.map((m) => m[1]);
const dimOpacity = /fill-opacity="([^"]+)"/.exec(template)?.[1] ?? "0.35";
// an icon's drawing, its gradient's id made the page's own
const body = (svg: string, id: string) => {
  const drawn = /<svg[^>]*>([\s\S]*)<\/svg>/.exec(svg)?.[1].replaceAll("face", `${id}-face`);
  if (!drawn) throw new Error(`${id} has no body`);
  return drawn;
};
// the Windows app's colour icon, and its icon in the notification area at each level a figure
// draws (Shell.cs `NotificationIcon`)
const trays = {
  "pb-tray": tray,
  "pb-tray-plenty": trayPlenty,
  "pb-tray-low": trayLow,
  "pb-tray-out": trayOut,
};
---

<svg class="absolute size-0 overflow-hidden" aria-hidden="true" focusable="false">
  <symbol id="pb-template" viewBox="0 0 16 16">
    <path d={board} fill="currentColor"></path>
    <path d={dim} fill="currentColor" fill-opacity={dimOpacity}></path>
  </symbol>
  {Object.entries(line).map(([id, d]) => <symbol id={id} viewBox="0 0 20 20">
    <path
      d={d}
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </symbol>)}
  <symbol id="sf-info-fill" viewBox="0 0 20 20">
    <path
      fill="currentColor"
      fill-rule="evenodd"
      d="M10 2.5a7.5 7.5 0 1 1 0 15 7.5 7.5 0 0 1 0-15ZM10 5.6a1.1 1.1 0 1 0 0 2.2 1.1 1.1 0 0 0 0-2.2ZM8.6 9.2v1.2h.8v3.4h-.8V15h2.8v-1.2h-.8V9.2Z"
    ></path>
  </symbol>
  <symbol id="sf-person-fill" viewBox="0 0 20 20">
    <path
      fill="currentColor"
      fill-rule="evenodd"
      d="M10 2.4a7.6 7.6 0 1 1 0 15.2 7.6 7.6 0 0 1 0-15.2ZM10 5.8a2.6 2.6 0 1 0 0 5.2 2.6 2.6 0 0 0 0-5.2ZM5.6 15c1-1.5 2.6-2.3 4.4-2.3s3.4.8 4.4 2.3a6.6 6.6 0 0 1-8.8 0Z"
    ></path>
  </symbol>
  {Object.entries(bar).map(([id, g]) => (
    <symbol id={id} viewBox={g.viewBox} set:html={g.body} />
  ))}
  {Object.entries(symbolic).map(([id, body]) => (
    <symbol id={id} viewBox="0 0 16 16" set:html={body} />
  ))}
  {Object.entries(trays).map(([id, svg]) => (
    <symbol id={id} viewBox="0 0 16 16" set:html={body(svg, id)} />
  ))}
  {Object.entries(fluent).map(([id, d]) => <symbol id={id} viewBox="0 0 20 20">
    <path d={d} fill="currentColor"></path>
  </symbol>)}
</svg>
