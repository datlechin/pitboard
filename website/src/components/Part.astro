---
// A part of a page for some systems, named above it only when no JavaScript chooses one.
import { labelOf, onOf, type Desktop, type Platform } from "../lib/platform.ts";

interface Props {
  on: (Platform | Desktop)[];
  // false where the part names its systems itself, as a table's caption does
  label?: boolean;
  class?: string;
}
const { on, label = true, class: extra } = Astro.props;
---

<div class={extra} data-on={onOf(on)}>
  {label && <p class="mb-2 hidden font-mono text-ui text-muted no-js:block">{labelOf(on)}</p>}
  <slot />
</div>
