---
import Base from "../layouts/Base.astro";
import CommandBlock from "../components/CommandBlock.astro";
import CommandBox from "../components/CommandBox.astro";
import Disclosure from "../components/Disclosure.astro";
import DownloadButton from "../components/DownloadButton.astro";
import { commands, linuxWays, windowsScoop } from "../data/commands.ts";
import { DOCS, REPO } from "../data/site.ts";
import { siteData } from "../lib/data.ts";
import { appZip, linuxApp, windowsMsi, windowsZip, type Release } from "../lib/github.ts";
import { onOf, platformNames, type Platform } from "../lib/platform.ts";
import { application } from "../lib/schema.ts";

const { downloads, windowsSigned } = await siteData();
const mac = downloads.macos.release;
const windows = downloads.windows.release;
const linux = downloads.linux.release;
const zip = appZip(mac);
const scoop = windowsScoop(windows);
const ways = linuxWays(linux);
const distros = [
  ["apt", "Debian and Ubuntu"],
  ["dnf", "Fedora"],
  ["zypper", "openSUSE"],
] as const;
const unsigned = windowsSigned ? "" : " Pitboard for Windows is not signed yet.";
const notes = (r: Release) => `/changelog#v${r.version}`;
const files = (r: Release) => `${REPO}/releases/tag/${r.tag}`;
// the other systems, as links that show each
const others = (p: Platform) =>
  (["macos", "windows", "linux"] as const)
    .filter((o) => o !== p)
    .map((o) => `<a href="#${o}">${platformNames[o]}</a>`)
    .join(" and ");
const part = "mt-10 max-w-[40rem] no-js:mt-(--block-space)";
const panelHead = "sr-only font-mono text-h2 text-strong no-js:not-sr-only max-sm:text-h2-sm";
const first = "no-js:mt-6";
const facts = "mt-3 flex flex-wrap gap-x-5 gap-y-1 text-ui text-muted";
const after = "mt-4 max-w-measure text-pretty js:not-data-shown:hidden";
const more = "mt-10 border-t";
const lead = "text-note text-fg [&:not(:first-child)]:mt-6";
const also = "mt-8 text-ui text-muted";
const tab =
  "cursor-pointer rounded-xs px-2.5 py-0.75 font-mono text-label font-medium text-fg aria-selected:bg-ink aria-selected:text-on-ink focus-visible:outline-offset-0 max-2xs:px-1.5";
const jsonLd = [application(Astro.site!, downloads)];
---

<Base
  title="Download Pitboard for macOS, Windows and Linux"
  description="Download the Pitboard app and its command line for macOS, Windows and Linux."
  current="download"
  path="/download"
  image="download"
  jsonLd={jsonLd}
>
  <main id="main">
    <div class="wrap pt-14 max-sm:pt-8">
      <h1 class="font-mono text-h1 text-strong max-sm:text-h1-sm">Download Pitboard</h1>

      <section class={part} id="macos" data-on={onOf(["macos"])} aria-labelledby="macos-title">
        <h2 class={panelHead} id="macos-title">{platformNames.macos}</h2>
        <DownloadButton class={first} platform="macos" href={zip.url} after />
        <div class={facts}>
          <p>{`Pitboard ${mac.version} for macOS 14 or later.`}</p>
          <p><a href={notes(mac)}>Release notes</a></p>
        </div>
        <p class={after} data-after="macos">
          Move Pitboard to your Applications folder before you open it.
        </p>
        <Disclosure class={more} id="macos-more" summary="More options" flush>
          <p class={lead}>Install the app with Homebrew:</p>
          <CommandBox command={commands.brewApp} />
          <p class={lead}>
            For the command line alone, run <a href={`${DOCS}/install/script`}>the install script</a
            >, or install it with Homebrew:
          </p>
          <CommandBox command={commands.installScript} />
          <CommandBox command={commands.brewCli} />
          <p class={lead}><a href={files(mac)}>Checksums and all files</a></p>
        </Disclosure>
        <p class={also} set:html={`Pitboard also runs on ${others("macos")}.`} />
      </section>

      <section
        class={part}
        id="windows"
        data-on={onOf(["windows"])}
        aria-labelledby="windows-title"
      >
        <h2 class={panelHead} id="windows-title">{platformNames.windows}</h2>
        <DownloadButton
          class={first}
          platform="windows"
          href={windowsMsi(windows, "x64").url}
          arm={windowsMsi(windows, "arm64").url}
          beta={windows.prerelease}
          after
        />
        <div class={facts}>
          <p>{`Pitboard ${windows.version} for Windows 11 24H2 or later.${unsigned}`}</p>
          <p><a href={notes(windows)}>Release notes</a></p>
        </div>
        <p class={after} data-after="windows">
          If Windows says it protected your PC, select <b>More info</b>, then <b>Run anyway</b>.
        </p>
        <Disclosure class={more} id="windows-more" summary="More options" flush>
          <p class={lead}>
            Download the installer for an
            <a href={windowsMsi(windows, "x64").url} data-download="windows">x64 PC</a> or an
            <a href={windowsMsi(windows, "arm64").url} data-download="windows">Arm PC</a>.
          </p>
          <p class={lead}>
            For the command line alone, download its zip for an
            <a href={windowsZip(windows, "x64").url}>x64 PC</a> or an
            <a href={windowsZip(windows, "arm64").url}>Arm PC</a>, then
            <a href={`${DOCS}/install#install-the-command-line-on-windows`}
              >put <code>pitboard.exe</code> on your <code>PATH</code></a
            >.
          </p>
          {scoop && <p class={lead}>Or install the command line with Scoop:</p>}
          {scoop && <CommandBlock commands={scoop} shell="pwsh" />}
          <p class={lead}><a href={files(windows)}>Checksums and all files</a></p>
        </Disclosure>
        <p class={also} set:html={`Pitboard also runs on ${others("windows")}.`} />
      </section>

      <section class={part} id="linux" data-on={onOf(["linux"])} aria-labelledby="linux-title">
        <h2 class={panelHead} id="linux-title">{platformNames.linux}</h2>
        <div
          class:list={[
            "flex w-fit max-w-full flex-wrap gap-0.5 rounded-sm border border-edge p-0.5 no-js:hidden",
            first,
          ]}
          role="tablist"
          aria-label="Linux distribution"
          data-tabs
        >
          {distros.map(([way, name], i) => <button
            class={tab}
            role="tab"
            type="button"
            id={`linux-${way}-tab`}
            aria-controls={`linux-${way}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? undefined : "-1"}
          >
            {name}
          </button>)}
        </div>
        {distros.map(([way, name], i) => <div
          class="mt-3 js:not-data-chosen:hidden no-js:mt-6"
          role="tabpanel"
          id={`linux-${way}`}
          aria-labelledby={`linux-${way}-tab`}
          data-chosen={i === 0 ? "" : undefined}
        >
          <p class="mb-2 hidden font-mono text-ui text-muted no-js:block">{`On ${name}:`}</p>
          <CommandBlock commands={ways[way]} />
        </div>)}
        <div class={facts}>
          <p>
            {`Pitboard ${linux.version} for Debian 13, Ubuntu 26.04, Fedora 43 and later, or openSUSE Tumbleweed, with GNOME or KDE Plasma.`}
          </p>
          <p><a href={notes(linux)}>Release notes</a></p>
          <p><a href={`${DOCS}/install/linux-repository`}>Check the repository's key</a></p>
        </div>
        <p class="mt-5 max-w-measure text-note text-pretty text-fg">
          On KDE Plasma 6.4 or later, <code>pitboard-plasma-widget</code> adds the Pitboard widget.
        </p>
        <p class="mt-3 max-w-measure text-note text-pretty text-fg">
          To install from a file, download the app's <code>.deb</code> for
          <a href={linuxApp(linux, "amd64.deb").url}>amd64</a> or
          <a href={linuxApp(linux, "arm64.deb").url}>arm64</a>, or its <code>.rpm</code> for
          <a href={linuxApp(linux, "x86_64.rpm").url}>x86_64</a> or
          <a href={linuxApp(linux, "aarch64.rpm").url}>aarch64</a>, and
          <a href={`${DOCS}/install/other-ways#a-linux-package`}
            >install it with the command line's package</a
          >.
        </p>
        <Disclosure class={more} id="linux-more" summary="More options" flush>
          <p class={lead}>
            For the command line alone, install <code>pitboard</code> in place of
            <code>pitboard-app</code>.
          </p>
          <p class={lead}>
            On another distribution, run <a href={`${DOCS}/install/script`}>the install script</a>,
            or install the command line with Homebrew:
          </p>
          <CommandBox command={commands.installScript} />
          <CommandBox command={commands.brewCli} />
          <p class={lead}><a href={files(linux)}>Checksums and all files</a></p>
        </Disclosure>
        <p class={also} set:html={`Pitboard also runs on ${others("linux")}.`} />
      </section>
    </div>
  </main>
</Base>
