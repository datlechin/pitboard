---
import Base from "../layouts/Base.astro";
import Block from "../components/Block.astro";
import Disclosure from "../components/Disclosure.astro";
import Icons from "../components/Icons.astro";
import InstallTabs from "../components/InstallTabs.astro";
import Part from "../components/Part.astro";
import Accounts from "../components/fig/mac/Accounts.astro";
import Activity from "../components/fig/mac/Activity.astro";
import Desk from "../components/fig/mac/Desk.astro";
import Figure from "../components/fig/Figure.astro";
import Notice from "../components/fig/mac/Notice.astro";
import OpenLink from "../components/fig/mac/OpenLink.astro";
import Settings from "../components/fig/mac/Settings.astro";
import Term from "../components/fig/Term.astro";
import WinAccounts from "../components/fig/win/Accounts.astro";
import WinActivity from "../components/fig/win/Activity.astro";
import WinDesk from "../components/fig/win/Desk.astro";
import WinNotice from "../components/fig/win/Notice.astro";
import WinSettings from "../components/fig/win/Settings.astro";
import Feature from "../components/home/Feature.astro";
import Row from "../components/home/Row.astro";
import { sessions } from "../data/sessions.ts";
import { DOCS, REPO, TAGLINE } from "../data/site.ts";
import { longDate } from "../lib/changelog.ts";
import { highlight, siteData } from "../lib/data.ts";
import type { Platform } from "../lib/platform.ts";
import { application } from "../lib/schema.ts";
import { recentReleases } from "../lib/shown.ts";
import { tools, type Tool } from "../data/world.ts";
import spark from "../assets/logos/claude-spark.svg?url";
import blossomBlack from "../assets/logos/openai-blossom-black.svg?url";
import blossomWhite from "../assets/logos/openai-blossom-white.svg?url";

const { versions, downloads } = await siteData();
// a beta's icon menu has no Check for updates
const updates = !downloads.windows.release.prerelease;
const recent = recentReleases(versions).map((v) => ({ ...v, highlight: highlight(v.version) }));
// a row is one string: on a phone its cells run inline, where whitespace between them would show
const cell = "border-b border-grid py-3.5 text-left align-baseline max-sm:border-0 max-sm:p-0";
const row = (v: (typeof recent)[number]) =>
  `<th class="${cell} pr-6 font-mono text-control font-semibold whitespace-nowrap max-sm:mr-3 max-sm:inline" scope="row"><a href="/changelog#v${v.version}">${v.version}</a></th><td class="${cell} pr-6 text-note/[1.5] whitespace-nowrap text-muted max-sm:inline">${longDate(v.date)}</td><td class="${cell} max-sm:mt-1 max-sm:block">${v.highlight}</td>`;
const guide = { claude: "claude-code", codex: "codex", desktop: "claude-desktop" };
// each company's own files, unaltered; Claude Code and Claude Desktop share Claude's spark
const sparkMark = { src: spark, class: "h-5 w-auto" };
// the Blossom's file holds its clear space: drawn at 40 pixels, the mark itself is 20
const blossom = "-my-2.5 h-10 w-auto";
const marks: Record<Tool, { src: string; class: string }[]> = {
  claude: [sparkMark],
  codex: [
    { src: blossomBlack, class: `${blossom} scheme-dark:hidden` },
    { src: blossomWhite, class: `${blossom} hidden scheme-dark:block` },
  ],
  desktop: [sparkMark],
};

const faq: { q: string; a: string | { on: Platform[]; a: string }[] }[] = [
  {
    q: "Does it work with API keys?",
    a: `No. Pitboard switches only logins to a Claude or ChatGPT account, not API keys or <a href="${DOCS}/concepts/limits#tools-and-sign-ins-pitboard-does-not-support">other providers</a>.`,
  },
  {
    q: "Does it work on a computer my company manages?",
    a: `Yes, within the company's settings: Pitboard refuses a switch or sign-in they rule out, and <a href="${DOCS}/reference/maintenance-commands#doctor"><code>pitboard doctor</code> names each setting</a>.`,
  },
  {
    q: "Is this allowed?",
    a: `<a href="${DOCS}/concepts/limits#is-this-allowed">Anthropic's and OpenAI's terms decide that</a>. Pitboard moves only your own logins and cannot share an account.`,
  },
  {
    q: "Why not use <code>/login</code> or <code>codex login</code>?",
    a: `Both replace the login in use, so the account you leave <a href="${DOCS}/guides/accounts#add-another-account">has to sign in again</a>.`,
  },
  {
    q: "Does Pitboard see my prompts?",
    a: `No. Pitboard <a href="${DOCS}/concepts/limits#rules">never sees a tool's requests</a>.`,
  },
  {
    q: "What happens if I uninstall it?",
    a: `Each tool stays signed in to the account in use. <a href="${DOCS}/install/remove#delete-parked-logins-first">The other accounts need signing in again</a>.`,
  },
  {
    q: "Can I script it?",
    a: `Yes. With <code>--json</code>, <a href="${DOCS}/reference/json-output#the-envelope">every command prints JSON</a>.`,
  },
  {
    q: "Does it have keyboard shortcuts?",
    // each system's own answer, both shown where no JavaScript chooses one
    a: [
      {
        on: ["macos", "linux"],
        a: `Yes. On macOS, the <b>Account</b> menu lists what you can do to the account selected, with <b>Forget</b> on <a href="${DOCS}/reference/mac-app#keyboard-shortcuts">Command-Delete</a>.`,
      },
      {
        on: ["windows"],
        a: `Yes. On Windows, <a href="${DOCS}/reference/windows-app#keyboard-shortcuts">Pitboard's keyboard shortcuts</a> include F2 to rename the account selected, Delete to forget it and Ctrl+C to copy its email address.`,
      },
    ],
  },
  {
    q: "Is Pitboard made by Anthropic or OpenAI?",
    a: `No. Pitboard is <a href="${REPO}/blob/main/NOTICE">not affiliated with either</a>.`,
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Pitboard",
    url: new URL("/", Astro.site).href,
  },
  application(Astro.site!, downloads),
];
---

<Base
  title="Pitboard: switch AI coding tools between your accounts"
  description="Switch AI coding tools between your accounts without signing out and see their usage, on macOS, Windows and Linux."
  current="home"
  path="/"
  image="home"
  jsonLd={jsonLd}
>
  <Icons slot="defs" />
  <main id="main">
    <section class="pt-14" aria-labelledby="hero-title">
      <div
        class="wrap grid grid-cols-[minmax(0,5fr)_minmax(0,7fr)] items-start gap-x-12 max-xl:grid-cols-[minmax(0,1fr)]"
      >
        <div class="pt-6">
          <h1 class="font-mono text-h1 text-strong max-sm:text-h1-sm" id="hero-title">Pitboard</h1>
          <p class="mt-4 max-w-lead text-lead text-pretty text-fg max-sm:text-lead-sm">{TAGLINE}</p>
          <p class="mt-4 hidden max-w-measure text-note text-pretty text-muted os-mobile:block">
            Pitboard runs on a Mac, a Windows PC or a Linux computer.
          </p>
          <InstallTabs class="mt-10" n={1} />
          <div class="mt-10 border-t border-grid pt-5 font-mono text-ui">
            <p class="text-muted">Works with</p>
            <ul class="mt-3 flex flex-wrap items-end gap-x-9 gap-y-4">
              {tools.map(([tool, name]) => <li class="flex items-end gap-x-1.5">
                <a class="flex flex-col items-start gap-2.5" href={`${DOCS}/guides/${guide[tool]}`}>
                  {marks[tool].map((m) => (
                    <img class={m.class} src={m.src} alt="" />
                  ))}
                  {name}
                </a>
                {tool === "desktop" && <span class="text-muted">on macOS</span>}
              </li>)}
            </ul>
          </div>
        </div>
        <Figure
          class="mt-8.75 max-xl:mt-8"
          app={{
            macos: {
              caption: "Switching accounts in Pitboard's menu on macOS.",
              describe:
                "Pitboard's menu open from the menu bar. Claude Code has personal, in use, and work; Codex has main, in use, and spare; Claude Desktop has home, in use, and office. Each Claude Code and Codex account shows its plan and how much of each limit it has used, and each Claude Desktop account reads No usage read. The pointer chooses work and the menu closes; the menu bar shows work 40%. The pointer opens the menu again, with work first and in use. Then the status line of the Claude Code session behind the menu puts work first.",
            },
            windows: {
              caption: "Switching accounts from Pitboard's icon on Windows.",
              describe:
                "Pitboard's menu open from its icon in the notification area. Claude Code has personal, in use, and work; Codex has main, in use, and spare, each with its plan and the most it has used of a limit. The pointer rests on work, whose tooltip reads 5-hour 12%, weekly 40%, then chooses it, and the menu closes. The icon's row grows from a short one to a long one, and its tooltip reads Pitboard, then work (Claude Code): 5-hour 12%, weekly 40%, then main (Codex): Weekly 7%. The menu opens again with work first and in use. Then the status line of the Claude Code session in Windows Terminal puts work first.",
            },
          }}
          cli={{
            macos: {
              caption: "The same accounts in a terminal.",
              describe:
                "<code>pitboard</code> in a terminal lists the Claude Code accounts work, in use, and personal, then the Codex accounts main, in use, and spare. Each limit has a bar, how much is used, when it resets and its pace. Then Claude Desktop, whose usage Pitboard does not read: home, in use, read 2h 05m ago, and office, whose sign-in may lapse in 25 days 3 hours.",
            },
            linux: {
              caption: "The same accounts in a terminal.",
              describe:
                "<code>pitboard</code> in a terminal lists the Claude Code accounts work, in use, and personal, then the Codex accounts main, in use, and spare. Each limit has a bar, how much is used, when it resets and its pace.",
            },
            windows: {
              caption: "The same accounts in a terminal.",
              describe:
                "<code>pitboard</code> in a terminal lists the Claude Code accounts work, in use, and personal, then the Codex accounts main, in use, and spare. Each limit has a bar, how much is used, when it resets and its pace.",
            },
          }}
        >
          <Desk prefix="hero-mac" demo />
          <WinDesk slot="win" prefix="hero-win" demo updates={updates} />
          <Term slot="cli" prefix="hero-cli" session={sessions.status} />
        </Figure>
      </div>
    </section>
    <Feature id="switch" title="Switch without signing out">
      <p>
        Choose an account in the app or run <code>pitboard use work</code>, and
        <a href={`${DOCS}/guides/switch#what-happens-to-open-sessions`}
          >open Claude Code sessions follow</a
        >. Daily renewal keeps your other Claude Code logins from expiring.
      </p>
      <Figure
        slot="fig"
        app={{
          macos: {
            caption: "The Pitboard window on macOS after the switch.",
            describe:
              "The top of the Accounts pane after a switch. A notice, Switched Claude Code to work, counts down: Claude Code sessions already open follow in 0:21. Under it, work is in use.",
          },
          windows: {
            caption: "The Pitboard window on Windows after the switch.",
            describe:
              "The top of the Accounts page after a switch. A notice, Switched Claude Code to work, counts down: Claude Code sessions already open follow in 0:21. Under it, work is in use.",
          },
        }}
        cli={{
          macos: {
            caption: "Switching from a terminal.",
            describe:
              "<code>pitboard use work</code> prints: Switched to work; personal is parked. Claude Code sessions already running follow within 33 seconds.",
          },
        }}
      >
        <Accounts prefix="switch-mac" moment="after" crop />
        <WinAccounts slot="win" prefix="switch-win" moment="after" crop />
        <Term slot="cli" prefix="switch-cli" session={sessions.use} />
      </Figure>
    </Feature>
    <Feature id="desktop" title="Claude Desktop">
      <p>
        On macOS, Pitboard switches <a href={`${DOCS}/guides/claude-desktop`}>Claude Desktop</a>
        too, and the app offers to quit Claude and open it again. On Windows and Linux, it leaves
        Claude Desktop alone.
      </p>
      <Figure
        slot="fig"
        app={{
          macos: {
            caption: "Claude Desktop in the Pitboard window on macOS.",
            describe:
              "The Claude Desktop section of the Accounts pane. home is in use: Read 2h 05m ago, with Claude closed. office has a Use button: Its sign-in may lapse in 25 days.",
          },
        }}
        cli={{
          macos: {
            caption: "Switching Claude Desktop from a terminal on macOS.",
            describe:
              "<code>pitboard use desktop/home</code> prints: Switched to desktop/home; desktop/office is parked. Claude opens signed in to it.",
          },
        }}
      >
        <Accounts prefix="desktop-mac" moment="after" only="desktop" />
        <Term slot="cli" prefix="desktop-cli" session={sessions.useDesktop} />
      </Figure>
    </Feature>

    <Feature id="usage" title="What each account has left">
      <p>
        Pitboard shows the usage, resets and <a href={`${DOCS}/concepts/usage#pace`}>pace</a> of
        each Claude Code and Codex account. <code>pitboard statusline</code> lists every Claude Code
        account in each session's status line.
      </p>
      <Figure
        slot="fig"
        app={{
          macos: {
            caption: "The Pitboard window on macOS.",
            describe:
              "The Accounts pane of the Pitboard window. personal is in use, with its weekly limit at 73% and 55% over pace, and the line: Weekly limit runs out in 11h 05m at this pace. work's parked login is good for 26 more days. Codex's main and spare follow, then Claude Desktop's home and office.",
          },
          windows: {
            caption: "The Pitboard window on Windows.",
            describe:
              "The Accounts page of the Pitboard window. personal is in use, with its weekly limit at 73% and 55% over pace, and the line: Weekly limit runs out in 11h 05m at this pace. work's parked login is good for 26 more days. Codex's main and spare follow.",
          },
        }}
        cli={{
          macos: {
            caption: "The same accounts in a terminal.",
            describe:
              "<code>pitboard</code> lists the Claude Code accounts personal, in use, with its weekly limit running out in 11 hours 5 minutes at this pace, and work, ready, its parked login good for 26 days 4 hours. Then the Codex accounts main, in use, and spare, and the Claude Desktop accounts home and office.",
          },
          linux: {
            caption: "The same accounts in a terminal.",
            describe:
              "<code>pitboard</code> lists the Claude Code accounts personal, in use, with its weekly limit running out in 11 hours 5 minutes at this pace, and work, ready, its parked login good for 26 days 4 hours. Then the Codex accounts main, in use, and spare.",
          },
          windows: {
            caption: "The same accounts in a terminal.",
            describe:
              "<code>pitboard</code> lists the Claude Code accounts personal, in use, with its weekly limit running out in 11 hours 5 minutes at this pace, and work, ready, its parked login good for 26 days 4 hours. Then the Codex accounts main, in use, and spare.",
          },
        }}
      >
        <Accounts prefix="usage-mac" moment="before" />
        <WinAccounts slot="win" prefix="usage-win" moment="before" />
        <Term slot="cli" prefix="usage-cli" session={sessions.statusBefore} />
      </Figure>
    </Feature>

    <section class="pt-(--block-space)" aria-labelledby="runs-out-title" id="runs-out">
      <div class="wrap">
        <h2
          class="border-t border-rule pt-(--block-in) font-mono text-h2 text-balance text-strong max-sm:text-h2-sm"
          id="runs-out-title"
        >
          Before an account runs out
        </h2>
        <Row id="offer-title" title="A warning first">
          <p>
            While the app is open, its
            <a href={`${DOCS}/guides/switch#get-a-notification-before-a-limit-runs-out`}
              >notification</a
            >
            offers another account with room left once the account in use reaches 95% of a limit.
          </p>
          <Figure
            slot="fig"
            app={{
              macos: {
                caption: "The notification on macOS at 95%.",
                describe:
                  "A notification from Pitboard: personal has used 95% of its weekly limit. Claude Code. work has 60% of its own left. It has a Switch button. The menu bar shows personal 95%.",
              },
              windows: {
                caption: "The notification on Windows at 95%.",
                describe:
                  "A notification from Pitboard in the corner of the screen: personal has used 95% of its weekly limit. Claude Code. work has 60% of its own left. It has a Switch button.",
              },
            }}
          >
            <Notice prefix="offer-mac" />
            <WinNotice slot="win" prefix="offer-win" />
          </Figure>
        </Row>
        <Row id="auto-title" title="Automatic switch" flip>
          <p>
            Pitboard can also
            <a href={`${DOCS}/guides/automatic-switching`}>switch Claude Code by itself</a>, from
            the app or from a background service that <code>pitboard watch install</code> sets up.
          </p>
          <Figure
            slot="fig"
            app={{
              macos: {
                caption: "Settings on macOS, in the Limits pane.",
                describe:
                  "The Limits pane of Pitboard's Settings: When a limit reaches, 95%, Switch Automatically. Under it: Watching work: 40% of its weekly limit, as of 20:50.",
              },
              windows: {
                caption: "Settings on Windows, under Limits.",
                describe:
                  "Pitboard's Settings under Limits: When a limit reaches, Switch automatically, and the line: Watching work: 40% of its weekly limit, as of 20:50. Under it, Share of a limit, 95.",
              },
            }}
            cli={{
              macos: {
                caption: "The same in the background, from a terminal.",
                describe:
                  "<code>pitboard watch install</code> prints that Pitboard watches Claude Code in the background at once and at each sign-in, switching once a limit of the account in use reaches 95% and warming up the accounts <code>pitboard warm on</code> turned on. Then it prints the file of its LaunchAgent, then that Anthropic's terms may cover automatic switching and warm-ups.",
              },
              linux: {
                caption: "The same in the background, from a terminal.",
                describe:
                  "<code>pitboard watch install</code> prints that Pitboard watches Claude Code in the background at once and at each sign-in, switching once a limit of the account in use reaches 95% and warming up the accounts <code>pitboard warm on</code> turned on. Then it prints that your user's systemd runs it while you are signed in, then the file of its systemd user service, then that Anthropic's terms may cover automatic switching and warm-ups.",
              },
              windows: {
                caption: "The same in the background, from a terminal.",
                describe:
                  "<code>pitboard watch install</code> prints that Pitboard watches Claude Code in the background at once and at each sign-in, switching once a limit of the account in use reaches 95% and warming up the accounts <code>pitboard warm on</code> turned on. Then it prints the path of its task in Task Scheduler, then that Anthropic's terms may cover automatic switching and warm-ups.",
              },
            }}
          >
            <Settings prefix="auto-mac" show="switch" />
            <WinSettings slot="win" prefix="auto-win" show="switch" />
            <Term slot="cli" prefix="auto-cli" session={sessions.watchInstall} />
          </Figure>
        </Row>
        <Row id="warm-title" title="Warm-up">
          <p>
            A <a href={`${DOCS}/guides/warm-up`}>warm-up</a> starts Claude Code's next five-hour
            period when the last one ends, with one short message.
          </p>
          <Figure
            slot="fig"
            app={{
              macos: {
                caption: "Warm-up in the Limits pane on macOS.",
                describe:
                  "Warm up limits, from 07:00 to 23:00. personal is turned on and warms up again at 22:00; work is off. Next warm-up: personal at 22:00.",
              },
              windows: {
                caption: "Warm-up in Settings on Windows, under Limits.",
                describe:
                  "Pitboard's Settings under Limits, with Warm up limits open: 07:00 to 23:00, and the line: Next warm-up: personal at 22:00. Under it, From 07:00 and To 23:00, personal turned on and warming up again at 22:00, and work off.",
              },
            }}
            cli={{
              macos: {
                caption: "The same from a terminal.",
                describe:
                  "<code>pitboard warm</code> says Pitboard warms up these accounts from 07:00 to 23:00: personal on, warms up again at 22:00; work off.",
              },
            }}
          >
            <Settings prefix="warm-mac" show="warm" />
            <WinSettings slot="win" prefix="warm-win" show="warm" />
            <Term slot="cli" prefix="warm-cli" session={sessions.warm} />
          </Figure>
        </Row>
      </div>
    </section>

    <Feature id="account-windows" title="claude.ai and chatgpt.com for each account">
      <p>
        The app opens claude.ai and chatgpt.com
        <a href={`${DOCS}/guides/account-windows`}>in a window for each account</a>. On macOS, a
        link shared from your browser opens as the account you choose.
      </p>
      <Figure
        slot="fig"
        app={{
          macos: {
            caption: "Opening a shared link as an account on macOS.",
            describe:
              "The Open Link window: Open this claude.ai link as: personal, or work, whose window is open. work is chosen, with Cancel and Open buttons.",
          },
          windows: {
            caption: "Opening claude.ai as an account from Pitboard's icon on Windows.",
            describe:
              "Pitboard's menu open from its icon in the notification area, with Open claude.ai showing work, in use, then personal.",
          },
        }}
      >
        <OpenLink prefix="windows-mac" />
        <WinDesk slot="win" prefix="windows-win" submenu="claude.ai" updates={updates} />
      </Figure>
    </Feature>

    <Feature id="security" title="Security and privacy">
      <p>
        Pitboard has no server and no telemetry, and
        <a href={`${DOCS}/security#what-leaves-your-machine`}
          >logins go only to the service that issued them</a
        >. <b>Activity</b> and <code>pitboard log</code> list every change it makes.
      </p>
      <Figure
        slot="fig"
        app={{
          macos: {
            caption: "The Activity pane on macOS.",
            describe:
              "The Activity pane of the Pitboard window lists the switch to work, the switch to desktop/home and a warm-up of personal, all asked by the Pitboard app, and the enrolment of work from the command line, each Done.",
          },
          windows: {
            caption: "The Activity page on Windows.",
            describe:
              "The Activity page of the Pitboard window lists the switch to work and a warm-up of personal, both asked by the Pitboard app, and the enrolment of work from the command line, each Done.",
          },
        }}
        cli={{
          macos: {
            caption: "The same from a terminal.",
            describe:
              "<code>pitboard log</code> lists the enrolment of work, a warm-up of personal, the switch to desktop/home and the switch to work, each ok.",
          },
          linux: {
            caption: "The same from a terminal.",
            describe:
              "<code>pitboard log</code> lists the enrolment of work, a warm-up of personal and the switch to work, each ok.",
          },
          windows: {
            caption: "The same from a terminal.",
            describe:
              "<code>pitboard log</code> lists the enrolment of work, a warm-up of personal and the switch to work, each ok.",
          },
        }}
      >
        <Activity prefix="security-mac" />
        <WinActivity slot="win" prefix="security-win" />
        <Term slot="cli" prefix="security-cli" session={sessions.log} />
      </Figure>
    </Feature>

    <Block titleId="releases-title" title="Recent releases">
      <div>
        <table
          class="w-full border-collapse text-table max-sm:block"
          aria-labelledby="releases-title"
        >
          <tbody class="max-sm:block">
            {recent.map((v) => (
              <tr
                class="max-sm:block max-sm:border-b max-sm:border-grid max-sm:py-3.5"
                set:html={row(v)}
              />
            ))}
          </tbody>
        </table>
        <p class="mt-5"><a href="/changelog">All releases</a></p>
      </div>
    </Block>

    <Block titleId="faq-title" title="Questions">
      <div>
        {faq.map((item) => <Disclosure summary={item.q}>
          {typeof item.a === "string" ? (
            <p set:html={item.a} />
          ) : (
            item.a.map((part) => <Part on={part.on} label={false}>
              <p set:html={part.a} />
            </Part>)
          )}
        </Disclosure>)}
      </div>
    </Block>

    <Block titleId="install-title" title="Install Pitboard">
      <div>
        <InstallTabs n={2} />
      </div>
    </Block>
  </main>
</Base>
