---
import "../styles/global.css";
import headScript from "../scripts/head.js?raw";
import interUrl from "../assets/fonts/Inter-4.1-opsz-wght.woff2?url";
import monoUrl from "../assets/fonts/JetBrainsMono-2.304-wght.woff2?url";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { OPEN_GRAPH } from "../lib/card.ts";
import { siteData } from "../lib/data.ts";
import { ogImage, type CardName } from "../lib/og.ts";

interface Props {
  title: string;
  description: string;
  current: "home" | "changelog" | "download" | null;
  path: string | null;
  jsonLd?: object[];
  // the link preview image; a page without one of its own shares the home page's
  image?: CardName;
}
const { title, description, current, path, jsonLd = [], image = "home" } = Astro.props;
const { stars } = await siteData();
const canonical = path === null ? null : new URL(path, Astro.site).href;

// one statement a line, comments and indentation dropped: the hash in the CSP covers this text
const head = headScript
  .split("\n")
  .map((l) => l.trim())
  .filter((l) => l && !l.startsWith("//"))
  .join("\n");

// Cloudflare Web Analytics, only when a token is given and only for the production branch
const token = process.env.PUBLIC_CF_BEACON_TOKEN;
const branch = process.env.WORKERS_CI_BRANCH;
if (token && !/^[0-9a-f]{32}$/.test(token)) {
  throw new Error("PUBLIC_CF_BEACON_TOKEN is not a Web Analytics token");
}
const beacon = token && (!branch || branch === "main") ? JSON.stringify({ token }) : null;
const og = await ogImage(image);
---

<!doctype html>
<html lang="en" class="scroll-pt-20 overflow-x-clip">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
      data-scheme="light"
    />
    <meta
      name="theme-color"
      content="#090b0b"
      media="(prefers-color-scheme: dark)"
      data-scheme="dark"
    />
    <script is:inline set:html={head} />
    {canonical && <link rel="canonical" href={canonical} />}
    {path === null && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Pitboard releases"
      href="/changelog/rss.xml"
    />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoUrl} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pitboard" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={new URL(og.path, Astro.site).href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OPEN_GRAPH.width)} />
    <meta property="og:image:height" content={String(OPEN_GRAPH.height)} />
    <meta property="og:image:alt" content={og.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={og.alt} />
    {jsonLd.map((data) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}
    {beacon && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={beacon}
      />
    )}
  </head>
  <body class="overflow-x-clip bg-page text-body text-fg antialiased max-sm:text-body-sm">
    <a
      class="absolute -top-15 left-4 z-50 bg-ink px-3 py-2 font-mono text-ui font-semibold text-on-ink no-underline focus:top-3"
      href="#main"
      >Skip to content</a
    >
    <slot name="defs" />
    <SiteHeader current={current} stars={stars} />
    <slot />
    <SiteFooter />
    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
