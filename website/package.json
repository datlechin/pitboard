{
  "name": "pitboard-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/csp.mjs && node scripts/guard.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "node --test \"src/lib/*.test.ts\" \"src/data/*.test.ts\" \"src/scripts/*.test.ts\" \"scripts/*.test.mjs\"",
    "test:browser": "playwright test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "nanostores": "1.5.5",
    "satori": "0.63.2",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "wrangler": "4.154.0"
  }
}
