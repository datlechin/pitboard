<?xml version="1.0" encoding="UTF-8"?>
<!-- Activity: every change Pitboard made, newest first, a line a change in a column view, or a
     status page while there is none, with Refresh in the header bar. Every word is the model's,
     set by pages/activity.rs, which makes the columns. -->
<interface>
  <requires lib="gtk" version="4.18"/>
  <requires lib="libadwaita" version="1.7"/>
  <template class="PitboardActivityPage" parent="AdwNavigationPage">
    <property name="tag">activity</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <child type="end">
              <object class="GtkButton" id="refresh">
                <property name="icon-name">view-refresh-symbolic</property>
              </object>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="GtkStack" id="stack">
            <child>
              <object class="GtkStackPage">
                <property name="name">empty</property>
                <property name="child">
                  <object class="AdwStatusPage" id="empty">
                    <property name="icon-name">document-open-recent-symbolic</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">lines</property>
                <property name="child">
                  <object class="GtkScrolledWindow">
                    <property name="child">
                      <object class="GtkColumnView" id="lines">
                        <property name="reorderable">False</property>
                        <style>
                          <class name="data-table"/>
                        </style>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
