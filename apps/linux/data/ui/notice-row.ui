<?xml version="1.0" encoding="UTF-8"?>
<!-- A notice, or the setup step's tip: its severity's symbol, its title and what it says, the
     buttons that do something about it, and the one that puts it away. Every word is the
     model's, set by window/notices.rs. -->
<interface>
  <requires lib="gtk" version="4.18"/>
  <requires lib="libadwaita" version="1.7"/>
  <template class="PitboardNoticeRow" parent="AdwActionRow">
    <property name="activatable">False</property>
    <property name="use-markup">False</property>
    <child type="prefix">
      <object class="GtkImage" id="mark">
        <property name="valign">center</property>
      </object>
    </child>
    <child type="suffix">
      <object class="GtkBox" id="buttons">
        <property name="valign">center</property>
        <property name="spacing">6</property>
      </object>
    </child>
    <child type="suffix">
      <object class="GtkButton" id="dismiss">
        <property name="icon-name">window-close-symbolic</property>
        <property name="valign">center</property>
        <property name="visible">False</property>
        <style>
          <class name="flat"/>
          <class name="circular"/>
        </style>
      </object>
    </child>
  </template>
</interface>
