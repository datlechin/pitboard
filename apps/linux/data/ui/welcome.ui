<?xml version="1.0" encoding="UTF-8"?>
<!-- The welcome, at the first launch: the app's icon over what Pitboard does, where it stays once
     its window is closed, each tool found with its step, start at sign-in, and Continue. Every
     word is the model's, set by dialogs/welcome.rs, which adds each tool's row. -->
<interface>
  <requires lib="gtk" version="4.18"/>
  <requires lib="libadwaita" version="1.7"/>
  <template class="PitboardWelcome" parent="AdwDialog">
    <property name="content-width">480</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="show-title">False</property>
          </object>
        </child>
        <property name="content">
          <object class="AdwStatusPage" id="status">
            <style>
              <class name="compact"/>
            </style>
            <property name="child">
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">24</property>
                <child>
                  <object class="GtkLabel" id="lives">
                    <property name="wrap">True</property>
                    <property name="justify">center</property>
                    <style>
                      <class name="dim-label"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup" id="tools"/>
                </child>
                <child>
                  <object class="AdwPreferencesGroup" id="start_group">
                    <child>
                      <object class="AdwSwitchRow" id="start_at_sign_in">
                        <property name="use-markup">False</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="start_failed">
                        <property name="visible">False</property>
                        <property name="wrap">True</property>
                        <property name="xalign">0</property>
                        <property name="margin-top">12</property>
                        <style>
                          <class name="caption"/>
                          <class name="error"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="done">
                    <property name="halign">center</property>
                    <style>
                      <class name="pill"/>
                      <class name="suggested-action"/>
                    </style>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
