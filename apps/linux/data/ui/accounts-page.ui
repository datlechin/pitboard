<?xml version="1.0" encoding="UTF-8"?>
<!-- The accounts page: a status page for each of the model's AccountsShown but List, and the
     list: the notices and the setup step's tip, then a group per account, which
     window/accounts.rs adds. Every word is the model's, set by window/accounts_page.rs. -->
<interface>
  <requires lib="gtk" version="4.18"/>
  <requires lib="libadwaita" version="1.7"/>
  <template class="PitboardAccountsPage" parent="AdwBin">
    <property name="child">
      <object class="GtkStack" id="stack">
        <child>
          <object class="GtkStackPage">
            <property name="name">status</property>
            <property name="child">
              <object class="AdwStatusPage" id="status">
                <property name="child">
                  <object class="GtkButton" id="status_action">
                    <property name="halign">center</property>
                    <style>
                      <class name="pill"/>
                      <class name="suggested-action"/>
                    </style>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">list</property>
            <property name="child">
              <object class="AdwPreferencesPage" id="list">
                <child>
                  <object class="AdwPreferencesGroup" id="notices_group">
                    <child>
                      <object class="GtkListBox" id="notices">
                        <property name="selection-mode">none</property>
                        <style>
                          <class name="boxed-list"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup" id="tip"/>
                </child>
              </object>
            </property>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
