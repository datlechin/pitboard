<?xml version="1.0" encoding="utf-8"?>
<!-- A window for one site and one account, not a browser: no address bar and no tabs of its own. WebView2's find bar,
     zoom, dialogs, download list and keys serve its page, and a page that leaves the site goes to the browser. -->
<Window
    x:Class="Pitboard.Views.AccountWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pitboard.Views"
    Title="Account">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>
  <Grid x:Name="Root" KeyboardAcceleratorPlacementMode="Hidden" PreviewKeyDown="OnPreviewKeyDown">
    <!-- Placed nowhere, or the grid shows "Ctrl+W" as a tooltip wherever the pointer rests. -->
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="W" Modifiers="Control" Invoked="OnClose" />
      <KeyboardAccelerator Key="F5" Invoked="OnReloadKey" />
      <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="OnReloadKey" />
    </Grid.KeyboardAccelerators>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <CommandBar HorizontalAlignment="Left" DefaultLabelPosition="Collapsed">
      <AppBarButton x:Name="BackButton" Label="Back" Icon="Back" ToolTipService.ToolTip="Show the previous page" Click="OnBack" />
      <AppBarButton x:Name="ForwardButton" Label="Forward" Icon="Forward" ToolTipService.ToolTip="Show the next page" Click="OnForward" />
      <AppBarButton x:Name="ReloadButton" Label="Reload" Icon="Refresh" ToolTipService.ToolTip="Load this page again" Click="OnReload" />
      <AppBarButton
          x:Name="StopButton"
          Label="Stop"
          Icon="Cancel"
          ToolTipService.ToolTip="Stop loading this page"
          Visibility="Collapsed"
          Click="OnStop" />
      <!-- Under it, at the left of the command bar, WebView2 opens its download list. -->
      <AppBarButton
          x:Name="DownloadsButton"
          Label="Downloads"
          Icon="Download"
          ToolTipService.ToolTip="Show this window’s downloads"
          Visibility="Collapsed"
          Click="OnShowDownloads" />
      <CommandBar.SecondaryCommands>
        <AppBarButton x:Name="RemoveDataButton" Label="Remove website data…" Icon="Delete" Click="OnRemoveData" />
      </CommandBar.SecondaryCommands>
    </CommandBar>
    <InfoBar
        x:Name="Note"
        Grid.Row="1"
        Severity="Informational"
        IsClosable="True"
        AutomationProperties.AutomationId="window.note"
        CloseButtonClick="OnNoteClosed" />
    <Grid x:Name="PageArea" Grid.Row="2">
      <local:EmptyState x:Name="StandIn" Chosen="OnStandInChosen" />
    </Grid>
  </Grid>
</Window>
