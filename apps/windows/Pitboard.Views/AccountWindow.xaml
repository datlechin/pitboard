<?xml version="1.0" encoding="utf-8"?>
<!-- A window for one site and one account, not a browser: no address bar and no tabs of its own. WebView2's find bar,
     zoom, dialogs, download list and keys serve its page, and a page that leaves the site goes to the browser. -->
<Window
    x:Class="Pitboard.Views.AccountWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pitboard.Views"
    xmlns:shown="using:Pitboard.Windows">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>
  <Grid x:Name="Root" KeyboardAcceleratorPlacementMode="Hidden" PreviewKeyDown="OnPreviewKeyDown">
    <!-- Placed nowhere, or the grid shows "Ctrl+W" as a tooltip wherever the pointer rests. -->
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="W" Modifiers="Control" Invoked="OnClose" />
      <KeyboardAccelerator Key="F5" Invoked="OnReloadKey" />
      <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="OnReloadKey" />
    </Grid.KeyboardAccelerators>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <CommandBar HorizontalAlignment="Left" DefaultLabelPosition="Collapsed">
      <AppBarButton
          x:Name="BackButton"
          Label="{x:Bind shown:Words.AccountWindow.Back}"
          Icon="Back"
          ToolTipService.ToolTip="{x:Bind shown:Words.AccountWindow.BackHelp}"
          Click="OnBack" />
      <AppBarButton
          x:Name="ForwardButton"
          Label="{x:Bind shown:Words.AccountWindow.Forward}"
          Icon="Forward"
          ToolTipService.ToolTip="{x:Bind shown:Words.AccountWindow.ForwardHelp}"
          Click="OnForward" />
      <AppBarButton
          x:Name="ReloadButton"
          Label="{x:Bind shown:Words.AccountWindow.Reload}"
          Icon="Refresh"
          ToolTipService.ToolTip="{x:Bind shown:Words.AccountWindow.ReloadHelp}"
          Click="OnReload" />
      <AppBarButton
          x:Name="StopButton"
          Label="{x:Bind shown:Words.AccountWindow.Stop}"
          Icon="Cancel"
          ToolTipService.ToolTip="{x:Bind shown:Words.AccountWindow.StopHelp}"
          Visibility="Collapsed"
          Click="OnStop" />
      <!-- Under it, at the left of the command bar, WebView2 opens its download list. -->
      <AppBarButton
          x:Name="DownloadsButton"
          Label="{x:Bind shown:Words.AccountWindow.Downloads}"
          Icon="Download"
          ToolTipService.ToolTip="{x:Bind shown:Words.AccountWindow.DownloadsHelp}"
          Visibility="Collapsed"
          AutomationProperties.AutomationId="window.downloads"
          Click="OnShowDownloads" />
      <CommandBar.SecondaryCommands>
        <AppBarButton
            x:Name="RemoveDataButton"
            Label="{x:Bind shown:Words.AccountWindow.RemoveWebsiteData}"
            Icon="Delete"
            AutomationProperties.AutomationId="window.removeData"
            Click="OnRemoveData" />
      </CommandBar.SecondaryCommands>
    </CommandBar>
    <InfoBar
        x:Name="Note"
        Grid.Row="1"
        Severity="Informational"
        IsClosable="True"
        AutomationProperties.AutomationId="window.note"
        CloseButtonClick="OnNoteClosed" />
    <Grid x:Name="PageArea" Grid.Row="2">
      <local:EmptyState x:Name="StandIn" Chosen="OnStandInChosen" />
    </Grid>
  </Grid>
</Window>
