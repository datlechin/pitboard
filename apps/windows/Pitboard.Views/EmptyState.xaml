<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Pitboard.Views.EmptyState"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pitboard.Views">
  <StackPanel
      MaxWidth="440"
      Padding="24"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Spacing="12">
    <FontIcon
        x:Name="EmptyMark"
        Glyph="{x:Bind Glyph, Mode=OneWay}"
        Visibility="{x:Bind local:EmptyState.MarkShown(Glyph, Busy), Mode=OneWay}"
        FontSize="40"
        IsTextScaleFactorEnabled="False"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        AutomationProperties.AccessibilityView="Raw" />
    <ProgressRing IsActive="{x:Bind Busy, Mode=OneWay}" Visibility="{x:Bind Busy, Mode=OneWay}" />
    <TextBlock
        HorizontalAlignment="Center"
        Text="{x:Bind Title, Mode=OneWay}"
        Style="{StaticResource SubtitleTextBlockStyle}"
        TextAlignment="Center"
        AutomationProperties.AutomationId="empty" />
    <TextBlock
        HorizontalAlignment="Center"
        Text="{x:Bind Detail, Mode=OneWay}"
        Visibility="{x:Bind local:EmptyState.Said(Detail), Mode=OneWay}"
        Style="{StaticResource SecondaryTextBlockStyle}"
        IsTextSelectionEnabled="True"
        TextAlignment="Center" />
    <Button
        x:Name="ChoiceButton"
        HorizontalAlignment="Center"
        AutomationProperties.AutomationId="empty.choice"
        Content="{x:Bind Choice, Mode=OneWay}"
        Visibility="{x:Bind local:EmptyState.Said(Choice), Mode=OneWay}"
        IsEnabled="{x:Bind IsChoiceEnabled, Mode=OneWay}"
        Click="OnChoice" />
  </StackPanel>
</UserControl>
