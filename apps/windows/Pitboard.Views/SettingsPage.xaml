<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pitboard.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shown="using:Pitboard.Windows"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Required">
  <!-- The toolkit's own sample of ItemsHeader and ItemsFooter: their cards take the style of the expander's items. -->
  <Page.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///CommunityToolkit.WinUI.Controls.SettingsControls/SettingsExpander/SettingsExpander.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Page.Resources>
  <Grid Padding="0,16,0,0" RowSpacing="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TextBlock
        MaxWidth="1064"
        Margin="{StaticResource PageHeaderMargin}"
        Text="{x:Bind shown:Words.Settings.Title}"
        Style="{StaticResource PageTitleTextBlockStyle}" />
    <!-- The WinUI Gallery's settings page: SettingsCards and SettingsExpanders in sections, each with its icon, the switch
         at each card's right. -->
    <ScrollViewer Grid.Row="1" Padding="{StaticResource PageContentPadding}">
      <StackPanel MaxWidth="1064" Spacing="{StaticResource SettingsCardSpacing}">
        <TextBlock
            x:Name="GeneralHeader"
            Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
            Margin="1,0,0,6"
            Text="{x:Bind shown:Words.Settings.General}" />
        <!-- The toolkit's own sample puts a HyperlinkButton in a card's description, which the card's template styles. -->
        <toolkit:SettingsCard Header="{x:Bind shown:Words.Settings.OpenAtLogin}">
          <toolkit:SettingsCard.HeaderIcon>
            <FontIcon Glyph="&#xE7E8;" />
          </toolkit:SettingsCard.HeaderIcon>
          <toolkit:SettingsCard.Description>
            <StackPanel>
              <TextBlock Text="{x:Bind ViewModel.StartupNote, Mode=OneWay}" AutomationProperties.AutomationId="settings.startupNote" />
              <TextBlock
                  x:Name="StartupFailed"
                  Style="{StaticResource CriticalCaptionTextBlockStyle}"
                  Visibility="Collapsed"
                  AutomationProperties.LiveSetting="Assertive" />
              <HyperlinkButton
                  Content="{x:Bind shown:Words.Settings.OpenStartupSettings}"
                  Visibility="{x:Bind ViewModel.OffersStartupSettings, Mode=OneWay}"
                  AutomationProperties.AutomationId="settings.startupSettings"
                  Click="OnOpenStartupSettings" />
            </StackPanel>
          </toolkit:SettingsCard.Description>
          <ToggleSwitch
              IsOn="{x:Bind ViewModel.StartsAtSignIn, Mode=OneWay}"
              IsEnabled="{x:Bind ViewModel.CanStartAtSignIn, Mode=OneWay}"
              AutomationProperties.AutomationId="settings.startAtSignIn"
              AutomationProperties.Name="{x:Bind shown:Words.Settings.OpenAtLogin}"
              Toggled="OnStartAtSignInToggled" />
        </toolkit:SettingsCard>
        <!-- A link rather than a clickable card, which UI Automation cannot press (docs/facts/windows-app.md). -->
        <toolkit:SettingsCard
            Header="{x:Bind shown:Words.Settings.Notifications}"
            Visibility="{x:Bind ViewModel.HasNotificationsOff, Mode=OneWay}"
            AutomationProperties.AutomationId="settings.notifications">
          <toolkit:SettingsCard.HeaderIcon>
            <FontIcon Glyph="&#xE7ED;" />
          </toolkit:SettingsCard.HeaderIcon>
          <toolkit:SettingsCard.Description>
            <StackPanel>
              <TextBlock Text="{x:Bind ViewModel.NotificationsOff, Mode=OneWay}" />
              <HyperlinkButton
                  Content="{x:Bind shown:Words.Settings.OpenNotificationSettings}"
                  Visibility="{x:Bind ViewModel.OffersNotificationSettings, Mode=OneWay}"
                  AutomationProperties.AutomationId="settings.notificationSettings"
                  Click="OnOpenNotificationSettings" />
            </StackPanel>
          </toolkit:SettingsCard.Description>
        </toolkit:SettingsCard>
        <toolkit:SettingsCard
            Header="{x:Bind shown:Words.Settings.CheckForUpdatesAutomatically}"
            Visibility="{x:Bind ViewModel.UpdatesAvailable, Mode=OneWay}">
          <toolkit:SettingsCard.HeaderIcon>
            <FontIcon Glyph="&#xE895;" />
          </toolkit:SettingsCard.HeaderIcon>
          <ToggleSwitch
              IsOn="{x:Bind ViewModel.ChecksAutomatically, Mode=OneWay}"
              AutomationProperties.AutomationId="settings.checkAutomatically"
              AutomationProperties.Name="{x:Bind shown:Words.Settings.CheckForUpdatesAutomatically}"
              Toggled="OnAutomaticChecksToggled" />
        </toolkit:SettingsCard>
        <!-- A card that cannot be clicked is a group, which Narrator names only by its own name. -->
        <toolkit:SettingsCard Header="{x:Bind shown:Words.Settings.Version}" AutomationProperties.Name="{x:Bind shown:Words.Settings.Version}">
          <toolkit:SettingsCard.HeaderIcon>
            <FontIcon Glyph="&#xE946;" />
          </toolkit:SettingsCard.HeaderIcon>
          <toolkit:SettingsCard.Description>
            <StackPanel>
              <TextBlock Text="{x:Bind ViewModel.UpdatesState, Mode=OneWay}" AutomationProperties.AutomationId="settings.version" />
              <ItemsControl ItemsSource="{x:Bind ViewModel.UpdatesNoteLines, Mode=OneWay}" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{x:Bind}" TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </toolkit:SettingsCard.Description>
          <Button
              MinWidth="120"
              Content="{x:Bind shown:Words.Settings.CheckNow}"
              AccessKey="C"
              IsEnabled="{x:Bind ViewModel.UpdatesAvailable, Mode=OneWay}"
              AutomationProperties.AutomationId="settings.checkNow"
              Click="OnCheckNow" />
        </toolkit:SettingsCard>

        <TextBlock x:Name="LimitsHeader" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Bind shown:Words.Settings.Limits}" />
        <toolkit:SettingsExpander Header="{x:Bind ViewModel.AtLimitHeading, Mode=OneWay}" AutomationProperties.AutomationId="settings.atLimitGroup">
          <toolkit:SettingsExpander.HeaderIcon>
            <FontIcon Glyph="&#xEC4A;" />
          </toolkit:SettingsExpander.HeaderIcon>
          <toolkit:SettingsExpander.Description>
            <StackPanel>
              <TextBlock
                  Text="{x:Bind ViewModel.AutoSwitchStanding, Mode=OneWay}"
                  Visibility="{x:Bind ViewModel.HasAutoSwitchStanding, Mode=OneWay}"
                  AutomationProperties.AutomationId="settings.autoSwitchStanding" />
              <TextBlock Text="{x:Bind ViewModel.AtLimitNote, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasAtLimitNote, Mode=OneWay}" />
              <HyperlinkButton
                  Content="{x:Bind ViewModel.TermsLinkTitle, Mode=OneWay}"
                  AutomationProperties.AutomationId="settings.atLimitTerms"
                  Click="OnOpenTerms" />
            </StackPanel>
          </toolkit:SettingsExpander.Description>
          <!-- Its items are added once the page has the model's words, before its bindings select one. -->
          <ComboBox
              x:Name="AtLimitChoices"
              MinWidth="200"
              SelectedIndex="{x:Bind ViewModel.AtLimitIndex, Mode=OneWay}"
              IsEnabled="{x:Bind ViewModel.CanChooseAtLimit, Mode=OneWay}"
              AutomationProperties.AutomationId="settings.atLimit"
              AutomationProperties.Name="{x:Bind ViewModel.AtLimitLabel, Mode=OneWay}"
              SelectionChanged="OnAtLimitChosen" />
          <toolkit:SettingsExpander.Items>
            <!-- Dimmed while nothing happens at the share: hidden, it left the open expander empty. -->
            <toolkit:SettingsCard
                Header="{x:Bind ViewModel.ShareTitle, Mode=OneWay}"
                Description="{x:Bind ViewModel.ShareRange, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.CanSetShare, Mode=OneWay}">
              <NumberBox
                  MinWidth="120"
                  Minimum="{x:Bind ViewModel.LowestShare, Mode=OneWay}"
                  Maximum="{x:Bind ViewModel.HighestShare, Mode=OneWay}"
                  Value="{x:Bind ViewModel.Share, Mode=OneWay}"
                  IsEnabled="{x:Bind ViewModel.CanSetShare, Mode=OneWay}"
                  SmallChange="1"
                  LargeChange="5"
                  SpinButtonPlacementMode="Inline"
                  AutomationProperties.AutomationId="settings.atLimitShare"
                  AutomationProperties.Name="{x:Bind ViewModel.ShareTitle, Mode=OneWay}"
                  ValueChanged="OnShareChanged" />
            </toolkit:SettingsCard>
          </toolkit:SettingsExpander.Items>
        </toolkit:SettingsExpander>
        <!-- What a warm-up does under its name and its hours beside it, as the approved mockup draws it. -->
        <toolkit:SettingsExpander
            x:Name="WarmUp"
            Header="{x:Bind ViewModel.WarmTitle, Mode=OneWay}"
            ItemsSource="{x:Bind ViewModel.WarmAccounts}"
            AutomationProperties.AutomationId="settings.warm">
          <toolkit:SettingsExpander.HeaderIcon>
            <FontIcon Glyph="&#xE706;" />
          </toolkit:SettingsExpander.HeaderIcon>
          <toolkit:SettingsExpander.Description>
            <StackPanel>
              <TextBlock Text="{x:Bind ViewModel.WarmNote, Mode=OneWay}" />
              <TextBlock
                  Text="{x:Bind ViewModel.WarmStanding, Mode=OneWay}"
                  Visibility="{x:Bind ViewModel.HasWarmStanding, Mode=OneWay}"
                  AutomationProperties.AutomationId="settings.warmStanding" />
            </StackPanel>
          </toolkit:SettingsExpander.Description>
          <TextBlock Text="{x:Bind ViewModel.WarmRange, Mode=OneWay}" AutomationProperties.AutomationId="settings.warmRange" />
          <toolkit:SettingsExpander.ItemsHeader>
            <StackPanel>
              <toolkit:SettingsCard
                  Header="{x:Bind shown:Words.Settings.From}"
                  Style="{StaticResource DefaultSettingsExpanderItemStyle}"
                  IsEnabled="{x:Bind ViewModel.CanWarm, Mode=OneWay}">
                <TimePicker
                    x:Name="WarmFrom"
                    SelectedTime="{x:Bind ViewModel.WarmFrom, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.CanWarm, Mode=OneWay}"
                    AutomationProperties.AutomationId="settings.warmFrom"
                    AutomationProperties.Name="{x:Bind shown:Words.Settings.WarmFrom}"
                    SelectedTimeChanged="OnWarmRangeChanged" />
              </toolkit:SettingsCard>
              <toolkit:SettingsCard
                  Header="{x:Bind shown:Words.Settings.To}"
                  Style="{StaticResource DefaultSettingsExpanderItemStyle}"
                  IsEnabled="{x:Bind ViewModel.CanWarm, Mode=OneWay}">
                <TimePicker
                    x:Name="WarmTo"
                    SelectedTime="{x:Bind ViewModel.WarmTo, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.CanWarm, Mode=OneWay}"
                    AutomationProperties.AutomationId="settings.warmTo"
                    AutomationProperties.Name="{x:Bind shown:Words.Settings.WarmTo}"
                    SelectedTimeChanged="OnWarmRangeChanged" />
              </toolkit:SettingsCard>
            </StackPanel>
          </toolkit:SettingsExpander.ItemsHeader>
          <toolkit:SettingsExpander.ItemTemplate>
            <DataTemplate x:DataType="shown:WarmAccountRow">
              <toolkit:SettingsCard
                  Header="{x:Bind Title, Mode=OneWay}"
                  Description="{x:Bind Standing, Mode=OneWay}"
                  IsEnabled="{x:Bind Enabled, Mode=OneWay}">
                <ToggleSwitch
                    Tag="{x:Bind Qualified}"
                    IsOn="{x:Bind On, Mode=OneWay}"
                    IsEnabled="{x:Bind Enabled, Mode=OneWay}"
                    AutomationProperties.AutomationId="{x:Bind AutomationId}"
                    AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                    Toggled="OnWarmToggled" />
              </toolkit:SettingsCard>
            </DataTemplate>
          </toolkit:SettingsExpander.ItemTemplate>
          <toolkit:SettingsExpander.ItemsFooter>
            <toolkit:SettingsCard
                Header="{x:Bind ViewModel.NoWarmAccount, Mode=OneWay}"
                Style="{StaticResource DefaultSettingsExpanderItemStyle}"
                Visibility="{x:Bind ViewModel.NoWarmAccounts, Mode=OneWay}" />
          </toolkit:SettingsExpander.ItemsFooter>
        </toolkit:SettingsExpander>

        <TextBlock x:Name="AdvancedHeader" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Bind shown:Words.Settings.Advanced}" />
        <toolkit:SettingsCard Header="{x:Bind shown:Words.Settings.KeepSavedSignInsFresh}">
          <toolkit:SettingsCard.HeaderIcon>
            <FontIcon Glyph="&#xE8D7;" />
          </toolkit:SettingsCard.HeaderIcon>
          <toolkit:SettingsCard.Description>
            <StackPanel>
              <TextBlock
                  Text="{x:Bind ViewModel.ScheduleNote, Mode=OneWay}"
                  Visibility="{x:Bind ViewModel.HasScheduleNote, Mode=OneWay}" />
              <TextBlock
                  x:Name="ScheduleFailed"
                  Style="{StaticResource CriticalCaptionTextBlockStyle}"
                  Visibility="Collapsed"
                  AutomationProperties.LiveSetting="Assertive" />
              <TextBlock Text="{x:Bind ViewModel.RenewalAbout, Mode=OneWay}" />
            </StackPanel>
          </toolkit:SettingsCard.Description>
          <ToggleSwitch
              IsOn="{x:Bind ViewModel.RenewsDaily, Mode=OneWay}"
              IsEnabled="{x:Bind ViewModel.CanRenewDaily, Mode=OneWay}"
              AutomationProperties.AutomationId="settings.renewDaily"
              AutomationProperties.Name="{x:Bind shown:Words.Settings.KeepSavedSignInsFresh}"
              Toggled="OnRenewDailyToggled" />
        </toolkit:SettingsCard>
        <!-- No button: the installer puts the command line on the PATH, and takes it off again. -->
        <toolkit:SettingsCard Header="{x:Bind shown:Words.Settings.CommandLine}" AutomationProperties.AutomationId="settings.commandLine">
          <toolkit:SettingsCard.HeaderIcon>
            <FontIcon Glyph="&#xE756;" />
          </toolkit:SettingsCard.HeaderIcon>
          <toolkit:SettingsCard.Description>
            <StackPanel>
              <TextBlock
                  Text="{x:Bind ViewModel.InTerminal, Mode=OneWay}"
                  IsTextSelectionEnabled="True"
                  AutomationProperties.AutomationId="settings.inTerminal" />
              <TextBlock Text="{x:Bind ViewModel.UpdateNote, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasUpdateNote, Mode=OneWay}" />
              <TextBlock Text="{x:Bind ViewModel.TerminalNote, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasTerminalNote, Mode=OneWay}" />
            </StackPanel>
          </toolkit:SettingsCard.Description>
          <ProgressRing
              Width="16"
              Height="16"
              IsActive="{x:Bind ViewModel.LookingForCommandLine, Mode=OneWay}"
              Visibility="{x:Bind ViewModel.LookingForCommandLine, Mode=OneWay}"
              AutomationProperties.Name="{x:Bind shown:Words.Settings.LookingForCommandLine}" />
        </toolkit:SettingsCard>

        <!-- Windows Settings' own uninstall says how it goes in its row, so this card does too. -->
        <toolkit:SettingsCard Header="{x:Bind shown:Words.Settings.Uninstall}" AutomationProperties.Name="{x:Bind shown:Words.Settings.Uninstall}">
          <toolkit:SettingsCard.HeaderIcon>
            <FontIcon Glyph="&#xE74D;" />
          </toolkit:SettingsCard.HeaderIcon>
          <toolkit:SettingsCard.Description>
            <StackPanel>
              <TextBlock
                  x:Name="UninstallStopped"
                  Style="{StaticResource CriticalCaptionTextBlockStyle}"
                  Visibility="Collapsed"
                  AutomationProperties.LiveSetting="Assertive" />
              <TextBlock Text="{x:Bind ViewModel.UninstallSays, Mode=OneWay}" AutomationProperties.AutomationId="settings.uninstallSays" />
            </StackPanel>
          </toolkit:SettingsCard.Description>
          <Grid>
            <ProgressRing
                Width="16"
                Height="16"
                IsActive="{x:Bind ViewModel.Uninstalling, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.Uninstalling, Mode=OneWay}"
                AutomationProperties.Name="{x:Bind ViewModel.UninstallSays, Mode=OneWay}" />
            <Button
                Content="{x:Bind ViewModel.UninstallChoice.Title, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.UninstallChoice.Enabled, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.OffersUninstall, Mode=OneWay}"
                AccessKey="U"
                AutomationProperties.AutomationId="settings.uninstall"
                Click="OnUninstall" />
          </Grid>
        </toolkit:SettingsCard>

        <!-- As Windows Settings keeps Troubleshoot: a clickable card for each page of its own. -->
        <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Bind shown:Words.Settings.Troubleshoot}" />
        <toolkit:SettingsCard
            Header="{x:Bind shown:Words.Window.Diagnostics}"
            Description="{x:Bind shown:Words.Settings.DiagnosticsAbout}"
            IsClickEnabled="True"
            AutomationProperties.AutomationId="settings.diagnostics"
            AutomationProperties.HelpText="{x:Bind shown:Words.Settings.DiagnosticsAbout}"
            Click="OnShowDiagnostics">
          <toolkit:SettingsCard.HeaderIcon>
            <FontIcon Glyph="&#xE9D9;" />
          </toolkit:SettingsCard.HeaderIcon>
        </toolkit:SettingsCard>
        <toolkit:SettingsCard
            Header="{x:Bind shown:Words.Window.Activity}"
            Description="{x:Bind shown:Words.Settings.ActivityAbout}"
            IsClickEnabled="True"
            AutomationProperties.AutomationId="settings.activity"
            AutomationProperties.HelpText="{x:Bind shown:Words.Settings.ActivityAbout}"
            Click="OnShowActivity">
          <toolkit:SettingsCard.HeaderIcon>
            <FontIcon Glyph="&#xE81C;" />
          </toolkit:SettingsCard.HeaderIcon>
        </toolkit:SettingsCard>

        <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Bind shown:Words.Settings.About}" />
        <!-- As the WinUI Gallery's About: the app's icon, name and copyright, its version, and its links under it. -->
        <toolkit:SettingsExpander
            x:Name="About"
            Margin="0,0,0,12"
            Header="{x:Bind shown:Words.AppName}"
            Description="{x:Bind shown:Words.Settings.Copyright}"
            AutomationProperties.AutomationId="settings.about"
            AutomationProperties.Name="{x:Bind shown:Words.Menu.About}">
          <toolkit:SettingsExpander.HeaderIcon>
            <ImageIcon Source="ms-appx:///Pitboard.ico" />
          </toolkit:SettingsExpander.HeaderIcon>
          <TextBlock
              Text="{x:Bind ViewModel.Version, Mode=OneWay}"
              Style="{StaticResource SecondaryTextBlockStyle}"
              IsTextSelectionEnabled="True" />
          <toolkit:SettingsExpander.Items>
            <toolkit:SettingsCard HorizontalContentAlignment="Left" ContentAlignment="Left">
              <StackPanel x:Name="Links" Margin="-12,0,0,0" />
            </toolkit:SettingsCard>
          </toolkit:SettingsExpander.Items>
        </toolkit:SettingsExpander>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
