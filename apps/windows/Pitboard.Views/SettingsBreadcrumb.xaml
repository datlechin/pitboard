<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Pitboard.Views.SettingsBreadcrumb"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pitboard.Views">
  <!-- Its items at the size and weight of a page's title, which TitleTextBlockStyle sets elsewhere. -->
  <BreadcrumbBar x:Name="Crumbs" ItemClicked="OnItemClicked">
    <BreadcrumbBar.Resources>
      <x:Double x:Key="BreadcrumbBarItemThemeFontSize">28</x:Double>
      <FontWeight x:Key="BreadcrumbBarItemFontWeight">SemiBold</FontWeight>
      <x:Double x:Key="BreadcrumbBarChevronFontSize">16</x:Double>
      <Thickness x:Key="BreadcrumbBarChevronPadding">11,4,12,0</Thickness>
    </BreadcrumbBar.Resources>
    <BreadcrumbBar.ItemTemplate>
      <DataTemplate x:DataType="local:Crumb">
        <TextBlock Text="{x:Bind Title}" AutomationProperties.HeadingLevel="{x:Bind Level}" />
      </DataTemplate>
    </BreadcrumbBar.ItemTemplate>
  </BreadcrumbBar>
</UserControl>
