<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pitboard.Views.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pitboard.Views"
    xmlns:shown="using:Pitboard.Windows"
    NavigationCacheMode="Required">
  <Grid Padding="0,16,0,0" RowSpacing="24">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="Sides">
        <VisualState x:Name="Wide" />
        <VisualState x:Name="Minimal">
          <VisualState.Setters>
            <Setter Target="PageHeader.Margin" Value="{StaticResource PageHeaderMarginMinimal}" />
            <Setter Target="AccountList.Padding" Value="{StaticResource PageContentPaddingMinimal}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid x:Name="PageHeader" Margin="{StaticResource PageHeaderMargin}" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Accounts" Style="{StaticResource PageTitleTextBlockStyle}" />
        <TextBlock Text="{x:Bind ViewModel.Updated, Mode=OneWay}" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
      </StackPanel>
      <CommandBar
          Grid.Column="1"
          VerticalAlignment="Center"
          Background="Transparent"
          DefaultLabelPosition="Right"
          OverflowButtonVisibility="Collapsed">
        <AppBarButton
            Label="Refresh"
            ToolTipService.ToolTip="Read every account’s usage again"
            IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
            AutomationProperties.AutomationId="accounts.refresh"
            Click="OnRefresh">
          <AppBarButton.Icon>
            <SymbolIcon Symbol="Refresh" />
          </AppBarButton.Icon>
          <AppBarButton.KeyboardAccelerators>
            <KeyboardAccelerator Key="F5" />
            <KeyboardAccelerator Key="R" Modifiers="Control" />
          </AppBarButton.KeyboardAccelerators>
        </AppBarButton>
        <AppBarButton
            Label="Add account"
            ToolTipService.ToolTip="Sign in to another account"
            KeyboardAcceleratorTextOverride="Ctrl+N"
            AutomationProperties.AutomationId="accounts.add"
            Click="OnAdd">
          <AppBarButton.Icon>
            <SymbolIcon Symbol="Add" />
          </AppBarButton.Icon>
        </AppBarButton>
      </CommandBar>
    </Grid>
    <ListView
        x:Name="AccountList"
        Grid.Row="1"
        Padding="{StaticResource PageContentPadding}"
        SelectionMode="Single"
        IsSynchronizedWithCurrentItem="False"
        Visibility="{x:Bind ViewModel.Listed, Mode=OneWay}"
        AutomationProperties.AutomationId="accounts"
        AutomationProperties.Name="Accounts"
        ContextRequested="OnContextRequested"
        DoubleTapped="OnDoubleTapped">
      <ListView.Header>
        <StackPanel Padding="0,0,0,8" Spacing="8">
          <StackPanel x:Name="Notices" Spacing="8" />
          <InfoBar
              IsClosable="False"
              IsOpen="{x:Bind ViewModel.HasSetup, Mode=OneWay}"
              Title="{x:Bind ViewModel.SetupTitle, Mode=OneWay}"
              Message="{x:Bind ViewModel.SetupDetail, Mode=OneWay}"
              AutomationProperties.AutomationId="{x:Bind local:AccountsPage.SetupId(ViewModel.SetupFooting), Mode=OneWay}">
            <InfoBar.IconSource>
              <FontIconSource Glyph="{x:Bind local:AccountsPage.SetupGlyph(ViewModel.SetupFooting), Mode=OneWay}" />
            </InfoBar.IconSource>
            <InfoBar.Content>
              <StackPanel x:Name="SetupChoices" Margin="0,0,0,12" Orientation="Horizontal" Spacing="8" />
            </InfoBar.Content>
          </InfoBar>
        </StackPanel>
      </ListView.Header>
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="shown:ShownAccount">
          <local:AccountRow Account="{x:Bind}" />
        </DataTemplate>
      </ListView.ItemTemplate>
      <ListView.GroupStyle>
        <GroupStyle>
          <GroupStyle.HeaderTemplate>
            <DataTemplate x:DataType="shown:ShownSection">
              <TextBlock
                  Text="{x:Bind Heading, Mode=OneWay}"
                  Style="{StaticResource BodyStrongTextBlockStyle}"
                  AutomationProperties.HeadingLevel="Level2" />
            </DataTemplate>
          </GroupStyle.HeaderTemplate>
        </GroupStyle>
      </ListView.GroupStyle>
    </ListView>
    <local:EmptyState
        Grid.Row="1"
        Visibility="{x:Bind ViewModel.ShowsEmpty, Mode=OneWay}"
        Glyph="{x:Bind local:AccountsPage.EmptyGlyph(ViewModel.Empty.Kind), Mode=OneWay}"
        Busy="{x:Bind local:AccountsPage.Busy(ViewModel.Empty.Kind), Mode=OneWay}"
        Title="{x:Bind ViewModel.Empty.Title, Mode=OneWay}"
        Detail="{x:Bind ViewModel.Empty.Detail, Mode=OneWay}"
        Choice="{x:Bind ViewModel.Empty.Choice, Mode=OneWay}"
        Prominent="{x:Bind ViewModel.Empty.Prominent, Mode=OneWay}"
        IsChoiceEnabled="{x:Bind ViewModel.Empty.Enabled, Mode=OneWay}"
        Chosen="OnEmptyChosen" />
  </Grid>
</Page>
