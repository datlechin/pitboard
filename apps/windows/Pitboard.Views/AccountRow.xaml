<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Pitboard.Views.AccountRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pitboard.Views">
  <UserControl.Resources>
    <Style x:Key="AccountMark" TargetType="FontIcon">
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="InUseMark" TargetType="FontIcon">
      <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="Plenty" TargetType="ProgressBar" BasedOn="{StaticResource DefaultProgressBarStyle}">
      <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
    </Style>
    <Style x:Key="Low" TargetType="ProgressBar" BasedOn="{StaticResource DefaultProgressBarStyle}">
      <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
    </Style>
    <Style x:Key="Out" TargetType="ProgressBar" BasedOn="{StaticResource DefaultProgressBarStyle}">
      <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>
  </UserControl.Resources>
  <Grid Padding="0,10" ColumnSpacing="12" RowSpacing="8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="28" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <FontIcon
        x:Name="Mark"
        Glyph="{x:Bind local:AccountRow.MarkOf(Account.Item), Mode=OneWay}"
        Style="{x:Bind MarkStyle(Account.Item.InUse), Mode=OneWay}"
        FontSize="20"
        VerticalAlignment="Center"
        IsTextScaleFactorEnabled="False"
        AutomationProperties.AccessibilityView="Raw" />
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
      <!-- Left-aligned, its star column takes only the name's width, so the tag follows the name and a long name is cut. -->
      <Grid x:Name="TitleRow" HorizontalAlignment="Left" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock
            x:Name="TitleText"
            Text="{x:Bind Account.Item.Title, Mode=OneWay}"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            TextWrapping="NoWrap"
            TextTrimming="CharacterEllipsis" />
        <Border
            x:Name="PlanTag"
            Grid.Column="1"
            VerticalAlignment="Center"
            Padding="6,0"
            CornerRadius="{StaticResource ControlCornerRadius}"
            Background="{ThemeResource ControlFillColorSecondaryBrush}"
            Visibility="{x:Bind local:AccountRow.PlanShown(Account.Item), Mode=OneWay}">
          <TextBlock x:Name="PlanText" Text="{x:Bind Account.Item.Plan, Mode=OneWay}" Style="{StaticResource SecondaryCaptionTextBlockStyle}" TextWrapping="NoWrap" />
        </Border>
      </Grid>
      <TextBlock
          x:Name="EmailText"
          Text="{x:Bind local:AccountRow.EmailLine(Account.Item), Mode=OneWay}"
          Visibility="{x:Bind local:AccountRow.EmailShown(Account.Item), Mode=OneWay}"
          Style="{StaticResource SecondaryCaptionTextBlockStyle}"
          TextWrapping="NoWrap"
          TextTrimming="CharacterEllipsis" />
    </StackPanel>
    <Grid Grid.Column="2" VerticalAlignment="Center">
      <ProgressRing
          x:Name="SwitchingRing"
          Width="16"
          Height="16"
          IsActive="{x:Bind local:AccountRow.Switching(Account.Item), Mode=OneWay}"
          Visibility="{x:Bind local:AccountRow.SwitchingShown(Account.Item), Mode=OneWay}"
          AutomationProperties.Name="{x:Bind local:AccountRow.SwitchingSpoken(Account.Item), Mode=OneWay}"
          AutomationProperties.AutomationId="account.switching" />
      <StackPanel x:Name="InUseLabel" Orientation="Horizontal" Spacing="6" Visibility="{x:Bind local:AccountRow.InUseShown(Account.Item), Mode=OneWay}">
        <FontIcon
            x:Name="InUseCheck"
            Glyph="&#xE73E;"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            IsTextScaleFactorEnabled="False"
            AutomationProperties.AccessibilityView="Raw" />
        <TextBlock
            Text="{x:Bind local:AccountRow.InUseTitle(Account.Item), Mode=OneWay}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            AutomationProperties.AutomationId="account.inUse" />
      </StackPanel>
      <Button
          x:Name="ActionButton"
          Content="{x:Bind local:AccountRow.ActionTitle(Account.Item), Mode=OneWay}"
          Visibility="{x:Bind local:AccountRow.ActionShown(Account.Item), Mode=OneWay}"
          AutomationProperties.Name="{x:Bind local:AccountRow.ActionSpoken(Account.Item), Mode=OneWay}"
          AutomationProperties.AutomationId="account.action"
          Click="OnAction" />
    </Grid>
    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Spacing="6">
      <Grid x:Name="Limits" ColumnSpacing="8" RowSpacing="4" />
      <StackPanel x:Name="Notes" Spacing="2" />
    </StackPanel>
  </Grid>
</UserControl>
