<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Pitboard.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shown="using:Pitboard.Windows">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>
  <!-- Microsoft's NavigationApp template: Mica reaches the title bar only once the content extends into it. -->
  <Grid x:Name="Root" KeyboardAcceleratorPlacementMode="Hidden">
    <!-- Placed nowhere, or the grid shows "F6" as a tooltip wherever the pointer rests. -->
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="F6" Invoked="OnNextRegion" />
      <KeyboardAccelerator Key="F6" Modifiers="Shift" Invoked="OnNextRegion" />
      <KeyboardAccelerator Key="W" Modifiers="Control" Invoked="OnClose" />
      <KeyboardAccelerator Key="F1" Invoked="OnHelp" />
      <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="OnBack" />
    </Grid.KeyboardAccelerators>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TitleBar x:Name="AppTitleBar" Title="{x:Bind shown:Words.AppName}" BackRequested="OnBackRequested">
      <TitleBar.IconSource>
        <ImageIconSource ImageSource="ms-appx:///Pitboard.ico" />
      </TitleBar.IconSource>
    </TitleBar>
    <NavigationView
        x:Name="Navigation"
        Grid.Row="1"
        PaneDisplayMode="LeftCompact"
        IsBackButtonVisible="Collapsed"
        KeyboardAcceleratorPlacementMode="Hidden"
        AutomationProperties.AutomationId="navigation"
        ItemInvoked="OnItemInvoked">
      <NavigationView.KeyboardAccelerators>
        <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnAddAccount" />
      </NavigationView.KeyboardAccelerators>
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="AccountsItem" Content="{x:Bind shown:Words.Window.Accounts}" AutomationProperties.AutomationId="pane.accounts">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE716;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>
      <!-- Each page owns its title, as the NavigationApp template's do, and is kept for the next visit. -->
      <Frame x:Name="Pages" IsNavigationStackEnabled="False" Navigated="OnNavigated" />
    </NavigationView>
  </Grid>
</Window>
