<?xml version="1.0" encoding="utf-8"?>
<!-- Plan 4.12's welcome, once, at the first launch: what Pitboard does, where its icon is, each tool found with Add, start
     at sign-in, and Get started, in a window of its own with only a close button. -->
<Window
    x:Class="Pitboard.Views.WelcomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Pitboard.Core"
    xmlns:local="using:Pitboard.Views"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>
  <ScrollViewer>
    <StackPanel
        x:Name="Root"
        Padding="40,32,40,32"
        Spacing="{StaticResource SettingsCardSpacing}"
        KeyboardAcceleratorPlacementMode="Hidden"
        AutomationProperties.AutomationId="welcome"
        Loaded="OnLoaded">
      <StackPanel.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
      </StackPanel.KeyboardAccelerators>
      <Image
          Width="64"
          Height="64"
          Margin="0,0,0,16"
          HorizontalAlignment="Left"
          AutomationProperties.AccessibilityView="Raw">
        <Image.Source>
          <SvgImageSource UriSource="ms-appx:///Pitboard.svg" />
        </Image.Source>
      </Image>
      <TextBlock x:Name="Heading" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />
      <TextBlock x:Name="Says" Margin="0,4,0,20" Style="{StaticResource SecondaryTextBlockStyle}" TextWrapping="Wrap" />
      <!-- The chevron the sentence names, which Windows shows its hidden icons from. -->
      <toolkit:SettingsCard x:Name="IconCard" AutomationProperties.AutomationId="welcome.icon">
        <toolkit:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE70E;" />
        </toolkit:SettingsCard.HeaderIcon>
        <toolkit:SettingsCard.Description>
          <HyperlinkButton x:Name="IconLink" AutomationProperties.AutomationId="welcome.iconLink" Click="OnIconLink" />
        </toolkit:SettingsCard.Description>
      </toolkit:SettingsCard>
      <TextBlock
          x:Name="ToolsHeading"
          Margin="1,24,0,6"
          Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
          AutomationProperties.HeadingLevel="Level2" />
      <ItemsControl x:Name="Tools" IsTabStop="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="{StaticResource SettingsCardSpacing}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <!-- Its account, which Pitboard reads only once Add is chosen for a tool other than Claude Code, and Add, what it
               was added as, or how to install it. -->
          <DataTemplate x:DataType="core:WelcomeTool">
            <!-- Named, so Narrator says whose Add it is: a card that cannot be clicked is a group with no name of its own. -->
            <toolkit:SettingsCard
                Header="{x:Bind Name}"
                Description="{x:Bind Account}"
                AutomationProperties.AutomationId="{x:Bind local:WelcomeWindow.ToolId(Code)}"
                AutomationProperties.Name="{x:Bind Name}">
              <toolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE756;" />
              </toolkit:SettingsCard.HeaderIcon>
              <Grid>
                <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind local:WelcomeWindow.AddedShown(Step)}">
                  <FontIcon
                      Glyph="&#xE73E;"
                      FontSize="12"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      IsTextScaleFactorEnabled="False"
                      AutomationProperties.AccessibilityView="Raw" />
                  <TextBlock Text="{x:Bind local:WelcomeWindow.AddedSaid(Step)}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button
                    Content="{x:Bind local:WelcomeWindow.AddTitle(Step)}"
                    IsEnabled="{x:Bind local:WelcomeWindow.AddEnabled(Step)}"
                    Visibility="{x:Bind local:WelcomeWindow.AddShown(Step)}"
                    Tag="{x:Bind}"
                    AutomationProperties.AutomationId="welcome.add"
                    Click="OnAdd" />
                <HyperlinkButton
                    Content="{x:Bind local:WelcomeWindow.InstallTitle(Step)}"
                    Visibility="{x:Bind local:WelcomeWindow.InstallShown(Step)}"
                    Tag="{x:Bind}"
                    AutomationProperties.AutomationId="welcome.install"
                    Click="OnInstall" />
              </Grid>
            </toolkit:SettingsCard>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <toolkit:SettingsCard x:Name="LoginCard" Margin="0,20,0,0">
        <toolkit:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE7E8;" />
        </toolkit:SettingsCard.HeaderIcon>
        <ToggleSwitch x:Name="StartsAtSignIn" AutomationProperties.AutomationId="welcome.startAtSignIn" Toggled="OnStartToggled" />
      </toolkit:SettingsCard>
      <Button
          x:Name="Done"
          MinWidth="120"
          Margin="0,24,0,0"
          HorizontalAlignment="Right"
          Style="{StaticResource AccentButtonStyle}"
          AccessKey="G"
          AutomationProperties.AutomationId="welcome.done"
          Click="OnDone" />
    </StackPanel>
  </ScrollViewer>
</Window>
