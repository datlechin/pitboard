<Project Sdk="WixToolset.Sdk">
  <!-- Pitboard.msi for one architecture, from Pitboard.App's Release publish, pitboard.exe, the pitboardw.exe beside it and its PowerShell completions. Builds on Windows only. -->
  <PropertyGroup>
    <OutputName>Pitboard</OutputName>
    <!-- The owner accepted WiX v7's Open Source Maintenance Fee EULA on 2026-10-15. -->
    <AcceptEula>wix7</AcceptEula>
    <!-- PitboardShare.exe and its package go in only when the package is signed, since only a signed one registers. -->
    <PitboardShareSigned Condition="'$(PitboardShareSigned)' != 'true'">false</PitboardShareSigned>
    <PitboardLauncher>$([System.IO.Path]::Combine($([System.IO.Path]::GetDirectoryName('$(PitboardCommandLine)')), 'pitboardw.exe'))</PitboardLauncher>
    <DefineConstants>ProductVersion=$(PitboardMsiVersion);App=$(PitboardApp);CommandLine=$(PitboardCommandLine);Launcher=$(PitboardLauncher);Completions=$(PitboardCompletions);ShareSigned=$(PitboardShareSigned)</DefineConstants>
    <!--
      ICE61 warns that MajorUpgrade replaces the same version, which AllowSameVersionUpgrades asks for: a beta and
      its final share three fields. ICE33 warns of pitboard://'s verb in the Registry table, warnings Microsoft calls
      obsolete, and a URL scheme has no table of its own. ICE03 checks every column of every table, and refuses the
      File table's languages for eight of WinUI's own files, so .github/scripts/validate-windows-msi.ps1 runs it after
      the build and refuses any other row. ICE40 warns of REINSTALLMODE in the Property table, which an upgrade that
      removes the old product after the new one's install needs, so the x64 and ARM64 MSIs of one version replace each
      other's files of an equal version.
    -->
    <SuppressIces>ICE03;ICE33;ICE40;ICE61</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" />
  </ItemGroup>
  <Target Name="CheckPitboardMsiInputs" BeforeTargets="CoreCompile">
    <Error Condition="'$(PitboardApp)' == '' or '$(PitboardCommandLine)' == '' or '$(PitboardCompletions)' == ''" Text="Pass the Release publish of Pitboard.App as PitboardApp, its pitboard.exe as PitboardCommandLine and the completions\pitboard.ps1 of the zip that holds that pitboard.exe as PitboardCompletions." />
    <Error Condition="!Exists('$(PitboardLauncher)')" Text="Pass a PitboardCommandLine with the pitboardw.exe of its build beside it." />
    <Error Condition="'$(PitboardMsiVersion)' == ''" Text="Pass the msi line .github/scripts/windows-versions.sh prints for Cargo.toml's version as PitboardMsiVersion." />
  </Target>
</Project>
