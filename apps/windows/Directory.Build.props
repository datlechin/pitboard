<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- SignPath signs only programs whose version resource names one product at one version. The SDK's defaults are each assembly's name. -->
    <Product>Pitboard</Product>
    <Company>Pitboard</Company>
    <!-- WinSparkle compares Pitboard.exe's version, and 1.0.0+<commit> sorts below 1.0.0. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- dotnet format cannot load a WinUI project without its XAML, so the build holds .editorconfig's style. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- A lock file holds the graph of each runtime it names, so both are named wherever a project restores. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <!-- nuget.org alone: the library-packs of a source-built SDK, such as Homebrew's, hold an ILCompiler that differs from nuget.org's. -->
    <DisableImplicitLibraryPacksFolder>true</DisableImplicitLibraryPacksFolder>
    <!-- Every test program takes test-as-standard-user.ps1's hang dump options: one that stops answering names the tests under way, which the timeout did not. -->
    <EnableMicrosoftTestingExtensionsHangDump>true</EnableMicrosoftTestingExtensionsHangDump>
  </PropertyGroup>
</Project>
