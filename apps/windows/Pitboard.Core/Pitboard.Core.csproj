<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The core's C# bindings, an assembly of their own. The code is generated into Generated/
    from pitboard_model by `cargo run -p uniffi-bindgen-csharp` and is not committed; it calls
    the pitboard_ffi native library.
  -->
  <PropertyGroup>
    <!-- Generated code reaches the library through pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Generated code is the generator's to warn about, not this build's to fail on. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
