<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Pitboard</string>
	<!-- Pitboard Debug for a debug build, in Shortcuts, Spotlight and the app menu. -->
	<key>CFBundleDisplayName</key>
	<string>$(PITBOARD_DISPLAY_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<!-- AppIcon.icon, or AppIcon-Debug.icon in a debug build, made in Icon Composer. -->
	<key>CFBundleIconFile</key>
	<string>$(ASSETCATALOG_COMPILER_APPICON_NAME)</string>
	<key>CFBundleIconName</key>
	<string>$(ASSETCATALOG_COMPILER_APPICON_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- scripts/build-app.sh sets these from the crate's version. -->
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>PitboardVersion</key>
	<string>$(PITBOARD_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- Starts in the menu bar alone. AppPresence adds the Dock icon while a window is open. -->
	<key>LSUIElement</key>
	<true/>
	<!-- A Pitboard link, pitboard://open?url=<a site's link>, which the Share extension
	     opens, shows the account picker. Pitboard defines the scheme, so its role is Editor.
	     project.yml sets the scheme per configuration. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).link</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(PITBOARD_URL_SCHEME)</string>
			</array>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
		</dict>
	</array>
	<!-- The same scheme, under the key the app and its Share extension both read it from. -->
	<key>PitboardURLScheme</key>
	<string>$(PITBOARD_URL_SCHEME)</string>
	<!-- What macOS shows if it asks before an account's window saves a download. -->
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Pitboard saves what you download in an account's window to your Downloads folder.</string>
</dict>
</plist>
